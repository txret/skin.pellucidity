<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">52</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include content="page_background"><param name="image" value="kodi.png"/></include>
        <control type="group">
            <posx>col_10_begin</posx>
            <posy>row_8_begin</posy>
            <include>modal_dialog_in_out_vertical</include>
            <control type="image">
                <posx>-12</posx>
                <posy>-12</posy>
                <width>456</width>
                <height>408</height>
                <texture>colors/black.png</texture>
                <colordiffuse>overlay</colordiffuse>
            </control>
            <control type="image">
                <width>6_col</width>
                <height>6_row</height>
                <texture>colors/white.png</texture>
                <colordiffuse>highlight</colordiffuse>
            </control>
            <control type="image">
                <posx>142</posx>
                <posy>36</posy>
                <width>4_row</width>
                <height>4_row</height>
                <texture>kodilogo.png</texture>
                <colordiffuse>text_active</colordiffuse>
            </control>
            <control type="list" id="52">
                <posy>228</posy>
                <width>6_col</width>
                <height>7_row</height>
                <itemlayout width="6_col" height="84">
                    <control type="image">
                        <width>69</width>
                        <height>2_row</height>
                        <texture fallback="colors/offblack.png">$INFO[Listitem.thumb]</texture>
                    </control>
                    <control type="image">
                        <posx>1_col</posx>
                        <width>5_col</width>
                        <height>69</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>5_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="6_col" height="84">
                    <control type="image">
                        <width>69</width>
                        <height>2_row</height>
                        <texture fallback="colors/black.png">$INFO[Listitem.thumb]</texture>
                        <include>spin_focus_thumb</include>
                    </control>
                    <control type="image">
                        <posx>1_col</posx>
                        <width>5_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>5_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <textcolor>black</textcolor>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </focusedlayout>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="LoginScreen.xml"/></include>
    </controls>
</window>
