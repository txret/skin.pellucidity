<?xml version="1.0" encoding="UTF-8"?>
<!--First window after the skin loads: resets the developer overlays, lets Skin Shortcuts build
    the menu includes, then jumps to the start window chosen in Kodi's settings.-->
<window>
    <defaultcontrol always="true">10</defaultcontrol>
    <onload>Skin.Reset(DebugInfo)</onload>
    <onload>Skin.Reset(DebugGrid)</onload>
    <!--build skin shortcuts includes (no-op when unchanged)-->
    <onload>RunScript(script.skinshortcuts,type=buildxml)</onload>
    <coordinates>
        <posx>15</posx>
        <posy>15</posy>
    </coordinates>
    <controls>
        <control type="button" id="10">
            <description>Startup Trigger</description>
            <onfocus>ReplaceWindow($INFO[System.StartupWindow])</onfocus>
            <texturefocus></texturefocus>
        </control>
        <include content="debug_overlay"><param name="label" value="Startup.xml"/></include>
    </controls>
</window>
