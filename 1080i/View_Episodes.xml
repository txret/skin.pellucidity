<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--Episodes of one season (view 53): season poster (or fanart) on the left half of the screen,
        numbered episode rows on the right. Applies to the library and to plugin listings that name
        their show; other plugin episode lists fall back to plain rows (view 52).-->
    <include name="view_episodes">
        <!--fanart-->
        <control type="group">
            <animation type="conditional" condition="control.isvisible(53)">
                <effect type="fade" start="0" end="100" time="1500"/>
                <effect type="slide" start="-100,0" end="0,0" time="300"/>
            </animation>
            <visible>!String.IsEmpty(container.folderpath) + container.content(episodes) + [[String.Contains(container.folderpath,videodb://) + !String.Contains(Container.folderpath,plugin)] | $EXP[is_plugin_show]]</visible>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <texture>colors/black.png</texture>
            </control>
            <control type="image">
                <visible>String.IsEmpty(container.art(season.poster))</visible>
                <width>960</width>
                <height>1080</height>
                <aspectratio aligny="bottom">scale</aspectratio>
                <texture fallback="colors/black.png">$INFO[fanart.image]</texture>
            </control>
            <control type="image">
                <visible>!String.IsEmpty(container.art(season.poster))</visible>
                <width>960</width>
                <height>1080</height>
                <aspectratio>scale</aspectratio>
                <texture>$INFO[container.art(season.poster)]</texture>
                <colordiffuse>ccffffff</colordiffuse>
            </control>
            <!--display clearart if available-->
            <control type="image">
                <posx>1068</posx>
                <posy>row_25_begin</posy>
                <width>4_col</width>
                <height>2_col</height>
                <texture>$INFO[ListItem.Art(clearlogo)]</texture>
                <aspectratio align="left">keep</aspectratio>
            </control>
        </control>
        <!--overlay-->
        <control type="group">
            <visible>!String.IsEmpty(container.folderpath) + container.content(episodes) + [[String.Contains(container.folderpath,videodb://) + !String.Contains(Container.folderpath,plugin)] | $EXP[is_plugin_show]]</visible>
            <posx>949</posx>
            <include content="page_background"><param name="image" value="tv.jpg"/></include>
        </control>
        <!--title-->
        <control type="group">
            <posx>col_13_begin</posx>
            <posy>row_5_begin</posy>
            <visible>!String.IsEmpty(container.folderpath) + container.content(episodes) + [[String.Contains(container.folderpath,videodb://) + !String.Contains(Container.folderpath,plugin)] | $EXP[is_plugin_show]]</visible>
            <control type="label">
                <posx>24</posx>
                <posy>-6</posy>
                <width>12_col</width>
                <height>2_row</height>
                <align></align>
                <font>large_title_2</font>
                <label>$INFO[Container.ShowTitle]</label>
            </control>
            <control type="label">
                <posx>24</posx>
                <posy>78</posy>
                <width>12_col</width>
                <align></align>
                <font>item_title</font>
                <textcolor>menu_unselected</textcolor>
                <label>$INFO[listitem.Season,$LOCALIZE[20373] , | ]$INFO[Container(53).NumItems,, $LOCALIZE[31189]]</label>
            </control>
        </control>
        <!--episode synopsis & thumb-->
        <control type="group">
            <!--tvhsow library-sourced episode list-->
            <control type="panel" id="53">
                <animation type="conditional" condition="!control.isvisible(53)">
                    <effect type="fade" start="100" end="0" time="0"/>
                </animation>
                <animation type="conditional" condition="control.isvisible(53)">
                    <effect type="fade" start="0" end="100" time="250" delay="150"/>
                </animation>
                <visible>$EXP[is_episode] + !String.Contains(container.folderpath,smb://) + [String.Contains(container.folderpath,videodb://) | $EXP[is_plugin_show]]</visible>
                <posx>978</posx>
                <posy>row_9_begin</posy>
                <width>12_col</width>
                <height>19_row</height>
                <onleft>9000</onleft>
                <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
                <pagecontrol>60</pagecontrol>
                <ondown>53</ondown>
                <onup>53</onup>
                <movement>4</movement>
                <itemlayout width="12_col" height="2_row">
                    <control type="image">
                        <width>1_col_textbox</width>
                        <height>69</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>textbox_inactive</colordiffuse>
                    </control>
                    <control type="label">
                        <width>1_col_textbox</width>
                        <height>69</height>
                        <align>center</align>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Episode]</label>
                    </control>
                    <control type="image">
                        <posx>1_col</posx>
                        <width>11_col</width>
                        <height>69</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>textbox_inactive</colordiffuse>
                    </control>
                    <control type="label">
                        <visible>ListItem.IsParentFolder</visible>
                        <posx>1_col_indent</posx>
                        <width>9_col</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>..</label>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>9_col</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="label">
                        <visible>!String.IsEmpty(ListItem.playcount)</visible>
                        <posx>11_col</posx>
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label></label>
                    </control>
                </itemlayout>
                <focusedlayout width="12_col" height="2_row">
                    <control type="image">
                        <animation type="focus">
                            <effect type="fade" start="100" end="50" time="0"/>
                        </animation>
                        <width>1_col_textbox</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="label">
                        <width>1_col_textbox</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Episode]</label>
                    </control>
                    <control type="image">
                        <posx>1_col</posx>
                        <width>11_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="label">
                        <visible>ListItem.IsParentFolder</visible>
                        <posx>1_col_indent</posx>
                        <width>9_col</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>..</label>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>9_col</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="label">
                        <visible>!String.IsEmpty(ListItem.playcount)</visible>
                        <posx>11_col</posx>
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label></label>
                    </control>
                </focusedlayout>
            </control>
            <!--Plugin-sourced Episode list-->
            <control type="panel" id="52">
                <visible>String.Contains(Container.folderpath,plugin) + !$EXP[is_plugin_show]</visible>
                <posx>col_1_begin</posx>
                <posy>row_5_begin</posy>
                <width>24_col</width>
                <height>23_row</height>
                <onleft>9000</onleft>
                <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
                <ondown>52</ondown>
                <onup>52</onup>
                <pagecontrol>60</pagecontrol>
                <itemlayout width="24_col" height="2_row">
                    <control type="image">
                        <posy>3</posy>
                        <width>66</width>
                        <height>66</height>
                        <aspectratio scalediffuse="false">stretch</aspectratio>
                        <texture fallback="colors/black.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                    </control>
                    <control type="image">
                        <posx>1_col</posx>
                        <width>23_col</width>
                        <height>69</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>textbox_inactive</colordiffuse>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>23_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <visible>!String.IsEmpty(ListItem.playcount)</visible>
                        <posx>23_col</posx>
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label></label>
                    </control>
                </itemlayout>
                <focusedlayout width="24_col" height="2_row">
                    <control type="image">
                        <posy>3</posy>
                        <width>66</width>
                        <height>66</height>
                        <aspectratio scalediffuse="false">stretch</aspectratio>
                        <texture fallback="colors/black.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                        <include>spin_focus_thumb</include>
                    </control>
                    <control type="image">
                        <posx>1_col</posx>
                        <width>23_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>23_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <visible>!String.IsEmpty(ListItem.playcount)</visible>
                        <posx>23_col</posx>
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label></label>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </include>
</includes>
