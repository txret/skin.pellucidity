<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--TV show library (view 52): same idea as the movie view. Group 9201 holds the recently
        added episodes / shows in progress row (selector 9202, row 9203), group 9204 the poster wall.-->
    <include name="view_tvshows">
        <control type="group">
            <visible>$EXP[is_tvshow] + !string.contains(container.folderpath,playlists)</visible>
            <include content="page_background"><param name="image" value="tv.jpg"/></include>
            <control type="group" id="9201">
                <visible>$EXP[is_tvshow] + !string.contains(container.folderpath,playlists) + !Skin.HasSetting(disableRecentTVShows)</visible>
                <animation type="Conditional" condition="!controlgroup(9201).hasfocus">
                    <effect type="slide" start="0,0" end="0,-200" time="200"/>
                    <effect type="fade" start="100" end="0" time="200"/>
                </animation>
                <animation type="Conditional" condition="controlgroup(9201).hasfocus">
                    <effect type="slide" start="0,-200" end="0,0" time="200" delay="300"/>
                    <effect type="fade" start="0" end="100" time="300" delay="350"/>
                </animation>
                <!--quick link selector-->
                <control type="list" id="9202">
                    <posx>col_1_begin</posx>
                    <posy>180</posy>
                    <width>24_col</width>
                    <height>2_row</height>
                    <onleft>9000</onleft>
                    <ondown>9203</ondown>
                    <onback>activateWindow(home)</onback>
                    <orientation>horizontal</orientation>
                    <include content="layout_view_category"><param name="width" value="4_col"/><param name="focus_condition" value="control.hasfocus(9202)"/></include>
                    <content>
                        <item id="1">
                            <label>special://skin/extras/playlists/recentEpisodes.xsp</label>
                            <property name="text_title">31178</property>
                        </item>
                        <item id="2">
                            <label>special://skin/extras/playlists/inprogressTVShows.xsp</label>
                            <property name="text_title">31127</property>
                        </item>
                    </content>
                </control>
                <!--quick links-->
                <control type="panel" id="9203">
                    <posx>90</posx>
                    <posy>288</posy>
                    <width>1740</width>
                    <height>11_row</height>
                    <onup>9202</onup>
                    <ondown>52</ondown>
                    <onleft>9000</onleft>
                    <onback>activateWindow(home)</onback>
                    <orientation>horizontal</orientation>
                    <onclick condition="container(9202).hasfocus(1)">activatewindow(Videos,videodb://tvshows/titles/$INFO[listitem.dbid]/)</onclick>
                    <itemlayout width="586" height="5_col_gutter">
                        <control type="image">
                            <width>566</width>
                            <height>318</height>
                            <texture>colors/black.png</texture>
                            <bordersize>12</bordersize>
                        </control>
                        <control type="image">
                            <visible>!string.isempty(ListItem.Art(fanart))</visible>
                            <width>566</width>
                            <height>318</height>
                            <texture>$INFO[ListItem.Art(fanart)]</texture>
                            <bordersize>12</bordersize>
                        </control>
                        <control type="image">
                            <visible>string.isempty(ListItem.Art(fanart))</visible>
                            <width>566</width>
                            <height>318</height>
                            <aspectratio>scale</aspectratio>
                            <texture>$INFO[ListItem.Art(thumb)]</texture>
                            <bordersize>6</bordersize>
                        </control>
                        <control type="label">
                            <visible>!controlgroup(9000).hasfocus + container(9202).hasfocus(1)</visible>
                            <posx>12</posx>
                            <posy>306</posy>
                            <width>584</width>
                            <height>2_row</height>
                            <font>thumb_title</font>
                            <label>[B]$INFO[ListItem.Title][/B][CR]$INFO[ListItem.Property(UnWatchedEpisodes),, $LOCALIZE[31189]]</label>
                        </control>
                        <control type="label">
                            <visible>!controlgroup(9000).hasfocus + container(9202).hasfocus(2)</visible>
                            <posx>12</posx>
                            <posy>306</posy>
                            <width>584</width>
                            <height>2_row</height>
                            <font>thumb_title</font>
                            <label>[B]$INFO[ListItem.tvshowtitle][/B][CR]$INFO[ListItem.label]</label>
                        </control>
                        <control type="progress">
                            <visible>ListItem.IsResumable</visible>
                            <description>Progress Bar</description>
                            <posx>12</posx>
                            <posy>294</posy>
                            <width>542</width>
                            <texturebg colordiffuse="textbox_inactive">colors/offblack.png</texturebg>
                            <midtexture colordiffuse="highlight">colors/white.png</midtexture>
                            <info>ListItem.PercentPlayed</info>
                        </control>
                    </itemlayout>
                    <focusedlayout width="586" height="5_col_gutter">
                        <control type="group">
                            <include>focus_thumb</include>
                            <control type="image">
                                <width>566</width>
                                <height>318</height>
                                <texture border="6">colors/black.png</texture>
                                <bordertexture colordiffuse="ffFFFFFF">colors/white.png</bordertexture>
                                <bordersize>6</bordersize>
                                <colordiffuse>FF000000</colordiffuse>
                            </control>
                            <control type="image">
                                <visible>!string.isempty(ListItem.Art(fanart))</visible>
                                <width>566</width>
                                <height>318</height>
                                <texture>$INFO[ListItem.Art(fanart)]</texture>
                                <bordersize>6</bordersize>
                            </control>
                            <control type="image">
                                <visible>string.isempty(ListItem.Art(fanart))</visible>
                                <width>566</width>
                                <height>318</height>
                                <aspectratio>scale</aspectratio>
                                <texture>$INFO[ListItem.Art(thumb)]</texture>
                                <bordersize>6</bordersize>
                            </control>
                            <control type="label">
                                <visible>!controlgroup(9000).hasfocus + container(9202).hasfocus(1)</visible>
                                <posx>12</posx>
                                <posy>316</posy>
                                <width>584</width>
                                <height>2_row</height>
                                <font>thumb_title</font>
                                <label>[B]$INFO[ListItem.Title][/B][CR]$INFO[ListItem.Property(UnWatchedEpisodes),, $LOCALIZE[31189]]</label>
                            </control>
                            <control type="label">
                                <visible>!controlgroup(9000).hasfocus + container(9202).hasfocus(2)</visible>
                                <posx>12</posx>
                                <posy>316</posy>
                                <width>584</width>
                                <height>2_row</height>
                                <font>thumb_title</font>
                                <label>[B]$INFO[ListItem.tvshowtitle][/B][CR]$INFO[ListItem.label]</label>
                            </control>
                            <control type="progress">
                                <visible>ListItem.IsResumable</visible>
                                <description>Progress Bar</description>
                                <posx>12</posx>
                                <posy>294</posy>
                                <width>542</width>
                                <texturebg colordiffuse="textbox_inactive">colors/offblack.png</texturebg>
                                <midtexture colordiffuse="highlight">colors/white.png</midtexture>
                                <info>ListItem.PercentPlayed</info>
                            </control>
                        </control>
                    </focusedlayout>
                    <content>$INFO[control.getlabel(9202)]</content>
                </control>
            </control>
        </control>
        <!--all TVShows-->
        <control type="group" id="9204">
            <animation type="Conditional" condition="controlgroup(9204).hasfocus | controlgroup(8000).hasfocus | controlgroup(9000).hasfocus | Skin.HasSetting(disableRecentTVShows)">
                <effect type="slide" start="0,0" end="0,-576" tween="sine" time="400"/>
            </animation>
            <control type="label">
                <visible>!controlgroup(9000).hasfocus + $EXP[is_tvshow] + !$EXP[is_movie]</visible>
                <posx>col_1_begin</posx>
                <posy>736</posy>
                <width>12_col</width>
                <height>2_row</height>
                <font>menu_title</font>
                <label>$LOCALIZE[31225]</label>
            </control>
            <control type="panel" id="52">
                <visible>$EXP[is_tvshow] + !$EXP[is_movie]</visible>
                <posx>90</posx>
                <posy>828</posy>
                <width>1800</width>
                <height>23_row</height>
                <onleft>9000</onleft>
                <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
                <onup>9203</onup>
                <onback>activateWindow(home)</onback>
                <scrolltime tween="sine">250</scrolltime>
                <itemlayout width="252" height="438">
                    <control type="image">
                        <visible>!ListItem.IsParentFolder</visible>
                        <posx>-6</posx>
                        <posy>-6</posy>
                        <width>240</width>
                        <height>354</height>
                        <texture>colors/black.png</texture>
                        <bordersize>6</bordersize>
                        <colordiffuse>11FFFFFF</colordiffuse>
                    </control>
                    <control type="image">
                        <width>228</width>
                        <height>342</height>
                        <texture>$INFO[ListItem.Art(poster)]</texture>
                        <bordersize>6</bordersize>
                    </control>
                    <control type="image">
                        <visible>ListItem.IsParentFolder</visible>
                        <posx>6</posx>
                        <posy>43</posy>
                        <width>216</width>
                        <height>216</height>
                        <aspectratio>keep</aspectratio>
                        <texture>$INFO[ListItem.Icon]</texture>
                        <colordiffuse>99FFFFFF</colordiffuse>
                    </control>
                    <control type="textbox">
                        <visible>String.IsEmpty(listitem.title) + !ListItem.IsParentFolder</visible>
                        <posx>24</posx>
                        <posy>3_row</posy>
                        <width>228</width>
                        <height>6_row</height>
                        <font>large_title</font>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                    <control type="label">
                        <visible>!System.Setting(hidewatched) + !controlgroup(9000).hasfocus</visible>
                        <posx>12</posx>
                        <posy>350</posy>
                        <width>204</width>
                        <font>thumb_title</font>
                        <label>[B]$INFO[ListItem.title][/B][CR]$INFO[ListItem.Property(TotalEpisodes),, $LOCALIZE[31189]]</label>
                    </control>
                    <control type="label">
                        <visible>System.Setting(hidewatched) + !controlgroup(9000).hasfocus</visible>
                        <posx>12</posx>
                        <posy>350</posy>
                        <width>204</width>
                        <font>thumb_title</font>
                        <label>[B]$INFO[ListItem.title][/B][CR]$INFO[ListItem.Property(UnWatchedEpisodes),, $LOCALIZE[31189]]</label>
                    </control>
                    <control type="group">
                        <visible>Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0)</visible>
                        <animation condition="true" effect="fade" end="70" time="0">conditional</animation>
                        <posx>167</posx>
                        <posy>6</posy>
                        <control type="image">
                            <width>56</width>
                            <height>56</height>
                            <texture>masks/newContent.png</texture>
                            <colordiffuse>highlight</colordiffuse>
                        </control>
                        <control type="label">
                            <posx>28</posx>
                            <posy>-4</posy>
                            <width>36</width>
                            <font>symbol</font>
                            <label></label>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout width="252" height="438">
                    <control type="group">
                        <include>focus_thumb</include>
                        <control type="image">
                            <visible>!ListItem.IsParentFolder</visible>
                            <width>228</width>
                            <height>342</height>
                            <texture border="6">colors/black.png</texture>
                            <bordertexture border="6" colordiffuse="FFFFFFFF">colors/white.png</bordertexture>
                            <bordersize>6</bordersize>
                            <colordiffuse>FF000000</colordiffuse>
                        </control>
                        <control type="image">
                            <width>228</width>
                            <height>342</height>
                            <texture>$INFO[ListItem.Art(poster)]</texture>
                            <bordersize>6</bordersize>
                        </control>
                        <control type="image">
                            <visible>ListItem.IsParentFolder</visible>
                            <posx>6</posx>
                            <posy>43</posy>
                            <width>216</width>
                            <height>216</height>
                            <aspectratio>keep</aspectratio>
                            <texture>$INFO[ListItem.Icon]</texture>
                        </control>
                        <control type="textbox">
                            <visible>String.IsEmpty(listitem.title) + !ListItem.IsParentFolder</visible>
                            <posx>24</posx>
                            <posy>3_row</posy>
                            <width>228</width>
                            <height>6_row</height>
                            <font>large_title</font>
                            <label>$INFO[ListItem.label]</label>
                        </control>
                        <control type="label">
                            <visible>!System.Setting(hidewatched) + !controlgroup(9000).hasfocus</visible>
                            <posx>12</posx>
                            <posy>354</posy>
                            <width>204</width>
                            <font>thumb_title</font>
                            <label>[B]$INFO[ListItem.title][/B][CR]$INFO[ListItem.Property(TotalEpisodes),, $LOCALIZE[31189]]</label>
                        </control>
                        <control type="label">
                            <visible>System.Setting(hidewatched) + !controlgroup(9000).hasfocus</visible>
                            <posx>12</posx>
                            <posy>354</posy>
                            <width>204</width>
                            <font>thumb_title</font>
                            <label>[B]$INFO[ListItem.title][/B][CR]$INFO[ListItem.Property(UnWatchedEpisodes),, $LOCALIZE[31189]]</label>
                        </control>
                        <control type="group">
                            <visible>Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0)</visible>
                            <posx>166</posx>
                            <posy>6</posy>
                            <control type="image">
                                <width>56</width>
                                <height>56</height>
                                <texture>masks/newContent.png</texture>
                                <colordiffuse>highlight</colordiffuse>
                            </control>
                            <control type="label">
                                <posx>28</posx>
                                <posy>-4</posy>
                                <width>36</width>
                                <font>symbol</font>
                                <label></label>
                            </control>
                        </control>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </include>
</includes>
