<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <control type="image">
            <width>fullscreen_width</width>
            <height>8_row</height>
            <texture>colors/black.png</texture>
            <colordiffuse>textbox_inactive</colordiffuse>
        </control>
        <!--video codec info label-->
        <control type="group">
            <posx>col_1_begin</posx>
            <posy>1_row</posy>
            <control type="label" id="1">
                <font>small_medium</font>
                <width>24_col</width>
                <label>$INFO[Player.SeekNumeric]</label>
            </control>
            <control type="label" id="10">
                <posy>2_row</posy>
                <font>small_medium</font>
                <width>24_col</width>
            </control>
            <control type="label" id="11">
                <posy>3_row</posy>
                <font>small_medium</font>
                <width>24_col</width>
            </control>
            <control type="label" id="12">
                <posy>4_row</posy>
                <font>small_medium</font>
                <width>24_col</width>
            </control>
        </control>
        <!--buffering label-->
        <control type="group">
            <posy>row_2_begin</posy>
            <visible>control.isvisible(24)</visible>
            <control type="image">
                <posy>-12</posy>
                <width>8_col</width>
                <height>102</height>
                <texture>colors/white.png</texture>
                <colordiffuse>eeFFFFFF</colordiffuse>
            </control>
            <control type="label">
                <description>heading</description>
                <posx>24</posx>
                <posy>-12</posy>
                <font>small_strong</font>
                <width>468</width>
                <label>20186</label>
                <textcolor>black</textcolor>
            </control>
            <control type="label" id="24">
                <description>buffering label</description>
                <posx>24</posx>
                <posy>30</posy>
                <font>dialog_title</font>
                <textcolor>black</textcolor>
                <width>468</width>
                <label>$LOCALIZE[15107] $INFO[Player.CacheLevel]%</label>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="VideoFullScreen.xml"/></include>
    </controls>
</window>
