<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9999</defaultcontrol>
    <onload condition="Skin.hassetting(stopVideoOnMenu) + !Player.HasAudio">PlayerControl(stop)</onload>
    <include>fade_in_out</include>
    <views>50</views>
    <controls>
        <include content="page_background"><param name="image" value="tv.jpg"/></include>
        <!--page container group-->
        <control type="group">
            <!--window fader-->
            <animation type="conditional" condition="window.next(0) | window.next(1)">
                <effect type="fade" start="100" end="0" time="300"/>
            </animation>
            <include>modal_dialog_content_shift</include>
            <!--Main content listing-->
            <control type="group" id="9999">
                <include>content_open</include>
                <include>view_live_tv_channels</include>
            </control>
            <include>page_scrollbar</include>
            <include>page_header</include>
            <control type="label" id="29">
                <visible>false</visible>
            </control>
        </control>
        <include>mini_video_player</include>
        <include>hub_menu</include>
        <include content="debug_overlay"><param name="label" value="MyPVRChannels.xml path: $INFO[container.folderpath] folder: $INFO[container.foldername] content: $INFO[container.content]"/></include>
    </controls>
</window>
