<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9999</defaultcontrol>
    <include>fade_in_out</include>
    <views>50,51,52,53,54,55,56,57,59</views>
    <controls>
        <include content="page_background"><param name="image" value="music.png"/></include>
        <control type="group">
            <visible>$EXP[is_music_song]</visible>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <aspectratio scalediffuse="false">stretch</aspectratio>
                <texture background="true">$INFO[Container.Art(artist.fanart)]</texture>
                <fadetime>500</fadetime>
                <colordiffuse>55ffffff</colordiffuse>
            </control>
            <control type="image">
                <texture>vignette.png</texture>
            </control>
        </control>
        <!--page container group-->
        <control type="group">
            <include>modal_dialog_content_shift</include>
            <!--Main content listing-->
            <control type="group" id="9999">
                <include>content_open</include>
                <!--source content-->
                <control type="group" id="9500">
                    <include>view_music_files</include>
                    <include>view_music_genres</include>
                    <include>view_artist_albums</include>
                    <include>view_artists</include>
                    <include>view_spotify_artists</include>
                    <include>view_albums</include>
                    <include>view_spotify_albums</include>
                    <include>view_songs</include>
                    <include>view_music_playlist</include>
                </control>
            </control>
            <include>jump</include>
            <include>page_header</include>
        </control>
        <include>mini_video_player</include>
        <include>hub_menu</include>
        <include>loading_indicator</include>
        <include content="debug_overlay"><param name="label" value="MyMusicNav.xml path: $INFO[container.folderpath]   name: $INFO[container.foldername]   content: $INFO[container.content]    Control: $INFO[System.CurrentControl]"/></include>
    </controls>
</window>
