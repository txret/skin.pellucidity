<?xml version="1.0" encoding="UTF-8"?>
<!--Power menu, opened by the button below the Home menu. Its items come from Skin Shortcuts
    (menu "powermenu", defaults in shortcuts/menus.xml) and are edited under Skin settings > Menus.-->
<window type="buttonMenu">
    <defaultcontrol always="true">8000</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include>modal_dialog_dim</include>
        <control type="group">
            <posx>col_10_begin</posx>
            <posy>7_row</posy>
            <include>modal_dialog_in_out_vertical</include>
            <control type="list" id="8000">
                <width>6_col</width>
                <height>14_row</height>
                <itemlayout width="6_col" height="2_row">
                    <control type="label">
                        <posx>12</posx>
                        <width>6_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="6_col" height="2_row">
                    <control type="image">
                        <width>6_col</width>
                        <height>2_row</height>
                        <aspectratio scalediffuse="false">scale</aspectratio>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="label">
                        <posx>12</posx>
                        <width>6_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </focusedlayout>
                <content>
                    <include>skinshortcuts-powermenu</include>
                </content>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogButtonMenu.xml"/></include>
    </controls>
</window>
