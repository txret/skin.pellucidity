<?xml version="1.0" encoding="UTF-8"?>
<!--Animations shared by windows and list layouts.
    Window-level ones (fade_in_out, content_open, modal_dialog_*) are included directly under <window> or
    on the group they move; the others go inside the control they animate.-->
<includes>
    <!--window: quick cross-fade on open and close-->
    <include name="fade_in_out">
        <animation effect="fade" time="100">WindowOpen</animation>
        <animation effect="fade" time="100">WindowClose</animation>
    </include>
    <!--effects for a "visible" animation: a list slides in from the right once its window is up-->
    <include name="list_slide_in">
        <effect type="fade" start="0" end="100" time="300" delay="600"/>
        <effect type="slide" start="3_col" end="0" center="auto" tween="cubic" easing="out" time="400" delay="500"/>
    </include>
    <!--media window content: zooms in on open, shrinks slightly on close-->
    <include name="content_open">
        <animation type="windowopen">
            <effect type="fade" start="0" end="100" time="500"/>
            <effect type="zoom" center="auto" start="120" end="100" time="300"/>
        </animation>
        <animation type="windowclose">
            <effect type="fade" start="100" end="0" time="300"/>
            <effect type="zoom" center="auto" start="100" end="98" time="300"/>
        </animation>
    </include>
    <!--fanart: slow looping zoom with a fade at both ends (Ken Burns style); off in low power mode-->
    <include name="ken_burns">
        <animation type="conditional" condition="!Skin.HasSetting(lowPowerMode)" loop="true">
            <effect type="fade" start="0" end="100" time="2000"/>
            <effect type="zoom" center="auto" start="120" end="100" time="15000"/>
            <effect type="fade" start="100" end="0" time="1000" delay="14000"/>
        </animation>
    </include>
    <!--focused button: the icon tile flips around its vertical axis (centre = half a 1_col tile)-->
    <include name="spin_focus_icon">
        <animation type="focus" loop="false" reversible="false">
            <effect type="fade" time="500"/>
            <effect type="rotatey" end="180" center="36" tween="back" easing="out" time="1000"/>
        </animation>
    </include>
    <!--focused round list thumbnail (66px): one full flip around its vertical axis-->
    <include name="spin_focus_thumb">
        <animation type="focus" loop="false" reversible="false">
            <effect type="fade" time="500"/>
            <effect type="rotatey" end="360" center="33" tween="back" easing="out" time="1000"/>
        </animation>
    </include>
    <!--focused poster / cover: pops up slightly larger than its neighbours-->
    <include name="focus_thumb">
        <animation type="focus" loop="false" reversible="false">
            <effect type="zoom" start="95" end="110" center="auto" tween="sine" easing="out" time="200"/>
        </animation>
    </include>
    <!--modal dialog body: slides in from the right, leaves to the left-->
    <include name="modal_dialog_in_out">
        <animation type="Windowopen">
            <effect type="fade" start="0" end="100" time="300"/>
            <effect type="slide" start="1920" end="0" tween="cubic" easing="out" time="400"/>
        </animation>
        <animation type="Windowclose">
            <effect type="fade" start="100" end="0" time="300"/>
            <effect type="slide" start="0" end="-1920" tween="cubic" easing="out" time="400"/>
        </animation>
    </include>
    <!--modal dialog body: drops in from above, leaves downwards-->
    <include name="modal_dialog_in_out_vertical">
        <animation type="Windowopen">
            <effect type="fade" start="0" end="100" time="300"/>
            <effect type="slide" start="0,-200" end="0" tween="cubic" easing="out" time="400"/>
        </animation>
        <animation type="Windowclose">
            <effect type="fade" start="100" end="0" time="300"/>
            <effect type="slide" start="0" end="0,300" tween="cubic" easing="out" time="400"/>
        </animation>
    </include>
    <!--page content: zooms towards the viewer while the hub menu (9000) or a dialog button
        panel (9002, 100) has focus, so the page reads as lying behind it-->
    <include name="modal_dialog_content_shift">
        <animation type="Conditional" condition="controlgroup(9000).hasfocus | controlgroup(9002).hasfocus | controlgroup(100).hasfocus">
            <effect type="zoom" end="140" time="200" center="auto" tween="linear" easing="out"/>
        </animation>
    </include>
</includes>
