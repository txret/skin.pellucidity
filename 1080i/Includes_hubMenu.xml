<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--main hub menu-->
    <include name="hub_menu">
        <control type="image">
            <include>dimensions_fullscreen</include>
            <texture>colors/black.png</texture>
            <colordiffuse>d5FFFFFF</colordiffuse>
            <animation type="Conditional" condition="controlgroup(9000).hasfocus">
                <effect type="fade" start="0" end="100" time="200"/>
            </animation>
            <animation type="Conditional" condition="!controlgroup(9000).hasfocus">
                <effect type="fade" start="100" end="0" time="100"/>
            </animation>
        </control>
        <control type="group" id="9000">
            <animation type="windowopen">
                <effect type="slide" start="-384" end="0" tween="sine" delay="500" time="400"/>
            </animation>
            <animation type="windowclose">
                <effect type="fade" start="100" end="0" time="0"/>
            </animation>
            <animation type="Conditional" condition="controlgroup(9000).hasfocus">
                <effect type="slide" start="-384" end="0" tween="sine" time="400"/>
            </animation>
            <animation type="Conditional" condition="!controlgroup(9000).hasfocus">
                <effect type="slide" start="0" end="-384" tween="sine" time="400"/>
            </animation>
            <!--drawer panel: the same translucent near-black as the info drawers (DialogVideoInfo.xml,
                DialogMusicInfo.xml), not the theme colour-->
            <control type="image">
                <posx>-200</posx>
                <posy>-200</posy>
                <width>584</width>
                <height>1500</height>
                <texture>colors/black.png</texture>
                <colordiffuse>cc111111</colordiffuse>
            </control>
            <!--logo-->
            <control type="label">
                <posx>col_1_begin</posx>
                <posy>78</posy>
                <width>73</width>
                <height>73</height>
                <font>symbol_very_large</font>
                <textcolor>eeffffff</textcolor>
                <label>$VAR[menu_logo]</label>
            </control>

            <!--player controls (if media playing)-->
            <control type="group">
                <posy>row_5_begin</posy>

                <control type="image">
                    <visible>player.playing + control.hasfocus(5115)</visible>
                    <width>col_5_begin</width>
                    <height>1_col</height>
                    <texture>colors/white.png</texture>
                </control>

                <control type="panel" id="5115">
                    <visible>player.playing</visible>
                    <posx>72</posx>
                    <width>col_5_begin</width>
                    <height>2_row</height>
                    <ondown>Control.SetFocus(9001)</ondown>
                    <onright condition="!window.isactive(1103)">9999</onright>
                    <onright condition="window.isactive(1103)">control.setfocus(9876)</onright>
                    <orientation>horizontal</orientation>
                    <itemlayout width="1_col" height="2_row">
                        <control type="label">
                            <width>1_col</width>
                            <height>2_row</height>
                            <align>center</align>
                            <font>symbol</font>
                            <label>$INFO[ListItem.label2]</label>
                        </control>
                        <control type="label">
                            <visible>control.hasfocus(5115)</visible>
                            <width>1_col</width>
                            <height>2_row</height>
                            <align>center</align>
                            <font>symbol</font>
                            <textcolor>highlight</textcolor>
                            <label>$INFO[ListItem.label2]</label>
                        </control>
                    </itemlayout>
                    <focusedlayout width="1_col" height="2_row">
                        <control type="image">
                            <posx>3</posx>
                            <posy>3</posy>
                            <width>66</width>
                            <height>66</height>
                            <texture>colors/white.png</texture>
                            <colordiffuse>highlight</colordiffuse>
                        </control>
                        <control type="label">
                            <width>1_col</width>
                            <height>2_row</height>
                            <align>center</align>
                            <font>symbol</font>
                            <label>$INFO[ListItem.label2]</label>
                        </control>
                    </focusedlayout>
                    <content>
                        <item>
                            <description>Previous</description>
                            <label2></label2>
                            <onclick>PlayerControl(previous)</onclick>
                        </item>
                        <item>
                            <description>Stop</description>
                            <label2></label2>
                            <onclick>PlayerControl(stop)</onclick>
                            <onclick>Dialog.Close(1103)</onclick>
                        </item>
                        <item>
                            <visible>Player.Playing | player.forwarding | player.rewinding</visible>
                            <description>Play/Pause</description>
                            <label2></label2>
                            <onclick>PlayerControl(play)</onclick>
                        </item>
                        <item>
                            <visible>Player.Paused</visible>
                            <description>Pause</description>
                            <label2></label2>
                            <onclick>PlayerControl(play)</onclick>
                        </item>
                        <item>
                            <description>Next Chapter</description>
                            <label2></label2>
                            <onclick>PlayerControl(next)</onclick>
                        </item>
                    </content>
                </control>
            </control>

            <control type="panel" id="9001">
                <animation condition="player.playing" effect="slide" end="0,72" time="0">conditional</animation>
                <posy>row_5_begin</posy>
                <width>col_5_begin</width>
                <height>832</height>
                <onleft condition="!window.isactive(home)">activateWindow(contextmenu)</onleft>
                <onright condition="!window.isactive(1103)">9999</onright>
                <onright condition="window.isactive(1103)">9876</onright>
                <onup condition="control.isvisible(5115)">control.setfocus(5115)</onup>
                <onback condition="!window.isactive(1103)">9999</onback>
                <onback condition="window.isactive(1103)">9876</onback>
                <itemlayout width="col_5_begin" height="2_row">
                    <control type="label">
                        <posx>col_1_begin</posx>
                        <width>4_col_gutter</width>
                        <height>2_row</height>
                        <font>menu_title_2</font>
                        <textcolor>eeffffff</textcolor>
                        <label>[CAPITALIZE]$INFO[ListItem.label][/CAPITALIZE]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="col_5_begin" height="2_row">
                    <control type="image">
                        <width>col_5_begin</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                    </control>
                    <control type="label">
                        <posx>col_1_begin</posx>
                        <width>4_col_gutter</width>
                        <height>2_row</height>
                        <font>menu_title_2</font>
                        <textcolor>highlight</textcolor>
                        <label>[CAPITALIZE]$INFO[ListItem.label][/CAPITALIZE]</label>
                    </control>
                </focusedlayout>
                <content>
                    <include condition="window.isactive(games)">skinshortcuts-gamesubmenu</include>
                    <include condition="window.isactive(pictures)">skinshortcuts-picturessubmenu</include>
                    <include condition="String.Contains(container.folderpath,videodb://musicvideos/titles) | window.isactive(music) | window.isactive(radiochannels) | window.isactive(radioguide) | window.isactive(radiorecordings) | window.isactive(radiotimers) | window.isactive(musicplaylist)">skinshortcuts-musicsubmenu</include>
                    <include condition="[window.isactive(videos) + !String.Contains(container.folderpath,videodb://musicvideos/titles)] | window.isactive(tvchannels) | window.isactive(tvrecordings) | window.isactive(tvguide) | window.isactive(tvtimers) | window.isactive(videoplaylist)">skinshortcuts-videosubmenu</include>
                </content>
            </control>
        </control>
    </include>
</includes>
