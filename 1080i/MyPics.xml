<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9999</defaultcontrol>
    <onload condition="Skin.hassetting(stopVideoOnMenu) + !Player.HasAudio">PlayerControl(stop)</onload>
    <include>fade_in_out</include>
    <views>50,51</views>
    <controls>
        <include content="page_background"><param name="image" value="photo.jpg"/></include>
        <!--page container group-->
        <control type="group">
            <include>modal_dialog_content_shift</include>
            <!--Main content listing-->
            <control type="group" id="9999">
                <include>content_open</include>
                <onleft>9000</onleft>
                <include>view_photos</include>
            </control>
            <!--page scrollbar: for the folder list only, the photo strip scrolls sideways-->
            <control type="group">
                <visible>!$EXP[is_photo_album]</visible>
                <include>page_scrollbar</include>
            </control>
            <include>page_header</include>
        </control>
        <include>hub_menu</include>
        <include>mini_video_player</include>
        <include content="debug_overlay"><param name="label" value="MyPics.xml path: $INFO[container.folderpath] folder: $INFO[container.foldername] content: $INFO[container.content]"/></include>
    </controls>
</window>
