<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">8000</defaultcontrol>
    <animation type="windowClose">
        <effect type="fade" start="100" end="0" time="400" delay="200"/>
    </animation>
    <controls>
        <!--background-->
        <control type="image">
            <visible>!String.Contains(Container.folderpath,plugin) + !container.content(episodes)</visible>
            <posx>0</posx>
            <posy>0</posy>
            <include>dimensions_fullscreen</include>
            <texture>colors/black.png</texture>
        </control>
        <control type="image">
            <visible>String.Contains(Container.folderpath,plugin) | container.content(episodes)</visible>
            <posx>0</posx>
            <posy>0</posy>
            <include>dimensions_fullscreen</include>
            <texture>colors/black.png</texture>
            <colordiffuse>ddffffff</colordiffuse>
        </control>
        <!--movie / tv show fanart-->
        <control type="group">
            <include condition="!String.Contains(Container.folderpath,plugin) + !container.content(episodes) + !container.content(musicvideos)">item_showcase</include>
            <!--music video-->
            <control type="group">
                <visible>container.content(musicvideos)</visible>
                <posx>3_col</posx>
                <posy>2_row</posy>
                <control type="image">
                    <width>12_col</width>
                    <height>12_col</height>
                    <aspectratio align="center" aligny="top">stretch</aspectratio>
                    <texture fallback="noAlbumCover.jpg">$INFO[Listitem.thumb]</texture>
                    <animation effect="rotateY" end="-7" center="auto,auto" time="500">windowOpen</animation>
                    <animation type="windowClose">
                        <effect type="rotateY" start="-7" end="0" center="auto,auto" time="500"/>
                        <effect type="slide" start="0" end="-1100" tween="cubic" easing="out" time="400"/>
                    </animation>
                </control>
                <control type="image">
                    <posy>12_col</posy>
                    <width>12_col</width>
                    <height>2_col</height>
                    <aspectratio align="center" aligny="top">scale</aspectratio>
                    <texture fallback="colors/black.png" diffuse="masks/thumbFader.png" flipy="true">$INFO[Listitem.thumb]</texture>
                    <animation type="windowOpen">
                        <effect type="rotateY" end="-7" center="auto,auto" time="500"/>
                    </animation>
                    <animation type="windowClose">
                        <effect type="rotateY" start="-7" end="0" center="auto,auto" time="500"/>
                        <effect type="slide" start="0" end="-1100" tween="cubic" easing="out" time="400"/>
                    </animation>
                </control>
            </control>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <texture>vignette.png</texture>
            </control>
            <control type="image">
                <posx>col_1_begin</posx>
                <posy>886</posy>
                <width>5_col</width>
                <texture>$INFO[ListItem.Art(clearlogo)]</texture>
                <aspectratio align="left">keep</aspectratio>
            </control>
        </control>
        <!--content is movie, music video or tvshow (from XBMC Library)-->
        <control type="group">
            <visible>!String.Contains(Container.folderpath,plugin) + !container.content(episodes)</visible>
            <posx>1200</posx>
            <animation type="Windowopen">
                <effect type="fade" start="0" end="100" time="300" delay="300"/>
                <effect type="slide" start="800" end="0" tween="cubic" easing="out" time="400" delay="300"/>
            </animation>
            <animation type="windowClose">
                <effect type="fade" start="100" end="0" time="350"/>
                <effect type="slide" start="0" end="900" tween="cubic" easing="out" time="400"/>
            </animation>
            <animation type="conditional" condition="control.hasfocus(8000)">
                <effect type="fade" start="0" end="100" time="300" delay="300"/>
                <effect type="slide" start="800" end="0" tween="cubic" easing="out" time="400" delay="300"/>
            </animation>
            <animation type="conditional" condition="!control.hasfocus(8000)">
                <effect type="fade" start="100" end="0" time="350"/>
                <effect type="slide" start="0" end="900" tween="cubic" easing="out" time="400"/>
            </animation>
            <!--overlay-->
            <control type="image">
                <width>10_col</width>
                <height>fullscreen_height</height>
                <texture>colors/black.png</texture>
                <colordiffuse>cc111111</colordiffuse>
            </control>
            <!--meta-->
            <control type="panel">
                <posx>12</posx>
                <posy>6_row</posy>
                <width>10_col</width>
                <height>6_row</height>
                <enable>false</enable>
                <include content="layout_info_text_row"><param name="height" value="76"/></include>
                <content>
                    <item>
                        <label>$LOCALIZE[562]</label>
                        <label2>$INFO[ListItem.year]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[515]</label>
                        <label2>$INFO[ListItem.genre]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[20339]</label>
                        <label2>$INFO[ListItem.director]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[180]</label>
                        <label2>$INFO[ListItem.duration]</label2>
                    </item>
                </content>
            </control>
            <!--content-->
            <control type="group">
                <posx>24</posx>
                <posy>row_1_begin</posy>
                <control type="label">
                    <posy>-6</posy>
                    <width>7_col</width>
                    <height>115</height>
                    <font>large_title</font>
                    <label>$INFO[listitem.title]</label>
                    <wrapmultiline>true</wrapmultiline>
                </control>
                <!--synopsis-->
                <control type="textbox">
                    <posy>9_row</posy>
                    <font>textbox</font>
                    <width>660</width>
                    <align>left</align>
                    <height>388</height>
                    <label fallback="31205">$INFO[ListItem.plot]</label>
                    <autoscroll>false</autoscroll>
                    <pagecontrol>61</pagecontrol>
                </control>
                <control type="scrollbar" id="61">
                    <posx>12r</posx>
                    <posy>10_row</posy>
                    <height>8_row</height>
                    <ondown>8000</ondown>
                </control>
            </control>
            <!--dialog controls-->
            <control type="panel" id="8000">
                <posx>12</posx>
                <posy>25_row</posy>
                <width>10_col</width>
                <height>6_row</height>
                <onup>61</onup>
                <onleft>999981</onleft>
                <include content="layout_info_button"><param name="bg_color" value="overlay"/><param name="label_width" value="4_col_gutter"/><param name="focus_label_width" value="4_col_gutter"/></include>
                <content>
                    <item>
                        <label>208</label>
                        <label2></label2>
                        <onclick>sendclick(2003,8)</onclick>
                    </item>
                    <item>
                        <label>20410</label>
                        <label2></label2>
                        <onclick>SendClick(2003,11)</onclick>
                    </item>
                    <item>
                        <label>31076</label>
                        <label2></label2>
                        <onclick>SendClick(2003,6)</onclick>
                    </item>
                    <item>
                        <label>13511</label>
                        <label2></label2>
                        <onclick>SendClick(2003,10)</onclick>
                    </item>
                </content>
            </control>
        </control>

        <!--content is tvshow episode or content is from a plugin-->
        <control type="group">
            <visible>String.Contains(Container.folderpath,plugin) | container.content(episodes)</visible>
            <include>modal_dialog_in_out</include>
            <!--thumbnail if available-->
            <control type="group">
                <posx>col_7_begin</posx>
                <posy>row_1_begin</posy>
                <control type="image">
                    <width>12_col</width>
                    <height>486</height>
                    <aspectratio scalediffuse="false" aligny="top">scale</aspectratio>
                    <texture fallback="colors/black.png">$INFO[Listitem.thumb]</texture>
                    <bordertexture colordiffuse="11ffffff">colors/white.png</bordertexture>
                    <bordersize>6</bordersize>
                </control>
            </control>
            <!--content-->
            <control type="group">
                <posx>col_7_begin</posx>
                <posy>row_15_begin</posy>
                <!--titles-->
                <control type="label">
                    <description>Episode title</description>
                    <posy>2_row</posy>
                    <width>12_col_gutter</width>
                    <height>2_row</height>
                    <font>large_title</font>
                    <label>$INFO[ListItem.Label]</label>
                    <wrapmultiline>true</wrapmultiline>
                </control>
                <control type="grouplist">
                    <posy>-20</posy>
                    <width>12_col</width>
                    <orientation>horizontal</orientation>
                    <control type="label">
                        <width>36</width>
                        <height>2_row</height>
                        <font>symbol_large</font>
                        <label></label>
                    </control>
                    <control type="label">
                        <width>11_col</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label fallback="13205">$INFO[listitem.duration]    [COLOR textbox_inactive]$INFO[listitem.filename][/COLOR]</label>
                    </control>
                </control>
                <!--synopsis-->
                <control type="textbox">
                    <posy>5_row</posy>
                    <font>textbox</font>
                    <width>12_col</width>
                    <align>left</align>
                    <height>160</height>
                    <label fallback="31205">$INFO[ListItem.plot]</label>
                    <autoscroll>false</autoscroll>
                    <pagecontrol>62</pagecontrol>
                </control>
                <control type="scrollbar" id="62">
                    <posx>-36</posx>
                    <posy>186</posy>
                    <height>4_row</height>
                    <ondown>8000</ondown>
                </control>
                <!--dialog controls-->
                <control type="list" id="8000">
                    <posy>11_row</posy>
                    <width>12_col</width>
                    <height>2_row</height>
                    <onup>62</onup>
                    <orientation>horizontal</orientation>
                    <include content="layout_info_button_list"><param name="width" value="6_col"/><param name="label_width" value="6_col"/><param name="focus_width" value="5_col"/></include>
                    <content>
                        <item id="1">
                            <label>208</label>
                            <label2></label2>
                            <onclick>sendclick(2003,8)</onclick>
                        </item>
                        <item id="2">
                            <visible>!String.Contains(Container.folderpath,plugin)</visible>
                            <label>31076</label>
                            <label2></label2>
                            <onclick>SendClick(2003,6)</onclick>
                        </item>
                    </content>
                </control>
            </control>
        </control>
        <!--buttons-->
        <control type="group">
            <visible>false</visible>
            <control type="button" id="8">
                <description>Play</description>
            </control>
            <control type="button" id="6">
                <description>Refresh</description>
            </control>
            <control type="button" id="7">
                <description>Ratings</description>
            </control>
            <control type="button" id="10">
                <description>Choose Art</description>
            </control>
            <control type="button" id="11">
                <description>Trailer</description>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogVideoInfo.xml"/></include>
    </controls>
</window>
