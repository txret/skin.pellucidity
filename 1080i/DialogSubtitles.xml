<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol>160</defaultcontrol>
    <controls>
        <control type="group" id="250">
            <posx>col_3_begin</posx>
            <posy>row_3_begin</posy>
            <include>modal_dialog_in_out_vertical</include>
            <!--dialog background-->
            <control type="image">
                <posx>-12</posx>
                <posy>-12</posy>
                <width>1464</width>
                <height>23_row</height>
                <texture>colors/black.png</texture>
                <colordiffuse>aaFFFFFF</colordiffuse>
            </control>
            <include content="dialog_title_bar"><param name="width" value="20_col"/><param name="label" value="$LOCALIZE[287] - $INFO[Player.Filename]"/></include>
            <!-- ** Required ** Do not change <id>or<type>-->
            <!--options-->
            <control type="label" id="140">
                <posx>col_4_begin</posx>
                <posy>84</posy>
                <width>12_col</width>
                <height>2_row</height>
                <font>item_title</font>
                <wrapmultiline>true</wrapmultiline>
            </control>
            <!--subtitle file selection-->
            <control type="panel" id="120">
                <posx>4_col</posx>
                <posy>156</posy>
                <width>16_col</width>
                <height>19_row</height>
                <onleft>150</onleft>
                <onright>60</onright>
                <scrolltime>200</scrolltime>
                <pagecontrol>60</pagecontrol>
                <itemlayout width="16_col" height="2_row">
                    <!--filename-->
                    <control type="label">
                        <posx>24</posx>
                        <width>12_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <info>ListItem.Label2</info>
                    </control>
                    <!--language / rating / sync / CC-->
                    <control type="label">
                        <posx>13_col</posx>
                        <width>3_col_gutter</width>
                        <height>2_row</height>
                        <font>item_subtitle</font>
                        <label>$INFO[ListItem.Label] - $INFO[ListItem.ActualIcon]*</label>
                    </control>
                </itemlayout>
                <focusedlayout width="16_col" height="2_row">
                    <control type="image">
                        <width>16_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                    </control>
                    <!--filename-->
                    <control type="label">
                        <posx>24</posx>
                        <width>12_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <textcolor>black</textcolor>
                        <selectedcolor>black</selectedcolor>
                        <info>ListItem.Label2</info>
                    </control>
                    <!--language / rating / sync / CC-->
                    <control type="label">
                        <posx>13_col</posx>
                        <width>3_col_gutter</width>
                        <height>2_row</height>
                        <font>item_subtitle</font>
                        <textcolor>black</textcolor>
                        <selectedcolor>black</selectedcolor>
                        <label>$INFO[ListItem.Label] - $INFO[ListItem.ActualIcon]*</label>
                    </control>
                </focusedlayout>
            </control>
            <!--page scrollbar-->
            <control type="group" id="8000">
                <visible>Control.IsVisible(60)</visible>
                <animation effect="fade" start="100" end="70" time="100" condition="!controlgroup(8000).hasfocus">conditional</animation>
                <control type="scrollbar" id="60">
                    <right>3_col</right>
                    <posy>2_row</posy>
                    <height>21_row</height>
                    <onleft>120</onleft>
                </control>
            </control>
            <!--manual search button-->
            <control type="button" id="160">
                <posy>84</posy>
                <label>31134</label>
                <ondown>150</ondown>
                <onright>120</onright>
            </control>
            <!--subtitle service choice-->
            <control type="list" id="150">
                <posy>168</posy>
                <width>4_col</width>
                <height>11_row</height>
                <onright>120</onright>
                <onup>160</onup>
                <scrolltime>200</scrolltime>
                <itemlayout width="4_col" height="84">
                    <control type="label">
                        <posx>24</posx>
                        <width>252</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <info>ListItem.Label</info>
                        <visible>!ListItem.property(man)</visible>
                    </control>
                    <control type="label">
                        <posx>24</posx>
                        <width>4_col_gutter</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <info>ListItem.Label</info>
                        <visible>ListItem.property(man)</visible>
                    </control>
                </itemlayout>
                <focusedlayout width="4_col" height="84">
                    <control type="image">
                        <visible>control.hasfocus(150)</visible>
                        <width>4_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                    </control>
                    <control type="image">
                        <visible>!control.hasfocus(150)</visible>
                        <width>4_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>aaFFFFFF</colordiffuse>
                    </control>
                    <control type="label">
                        <posx>12</posx>
                        <width>252</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <textcolor>black</textcolor>
                        <selectedcolor>black</selectedcolor>
                        <info>ListItem.Label</info>
                        <visible>!ListItem.property(man)</visible>
                    </control>
                    <control type="label">
                        <posx>12</posx>
                        <width>252</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <textcolor>black</textcolor>
                        <selectedcolor>black</selectedcolor>
                        <info>ListItem.Label</info>
                        <visible>ListItem.property(man)</visible>
                    </control>
                </focusedlayout>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogSubtitles.xml"/></include>
    </controls>
</window>
