<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">4</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include content="page_background"><param name="image" value="settings.jpg"/></include>
        <control type="group">
            <posx>col_9_begin</posx>
            <posy>row_4_begin</posy>
            <include>modal_dialog_in_out_vertical</include>
            <animation type="conditional" condition="window.isactive(profilesettings)">
                <effect type="fade" start="100" end="0" time="300"/>
                <effect type="rotatey" start="0" end="90" center="960" tween="cubic" easing="out" time="500"/>
            </animation>
            <control type="image">
                <posx>-12</posx>
                <posy>-12</posy>
                <width>600</width>
                <height>768</height>
                <texture>colors/black.png</texture>
                <colordiffuse>overlay</colordiffuse>
            </control>
            <include content="dialog_title_bar"><param name="width" value="8_col"/><param name="label" value="14210"/></include>
            <control type="image">
                <description>profile image</description>
                <posy>84</posy>
                <width>8_col</width>
                <height>10_row</height>
                <texture fallback="colors/black.png">$INFO[System.ProfileThumb]</texture>
                <aspectratio>scale</aspectratio>
            </control>
            <control type="image">
                <posy>372</posy>
                <width>8_col</width>
                <height>73</height>
                <texture>colors/black.png</texture>
                <colordiffuse>textbox_inactive</colordiffuse>
            </control>
            <control type="label">
                <posy>372</posy>
                <width>8_col</width>
                <height>2_row</height>
                <align>center</align>
                <font>item_subtitle</font>
                <label>$LOCALIZE[31107]: [COLOR highlight]$INFO[System.ProfileName][/COLOR]</label>
            </control>
            <!--dialog controls-->
            <control type="radiobutton" id="4">
                <description>Enable Login Screen</description>
                <posy>456</posy>
                <width>8_col</width>
                <label>20096</label>
                <texturenofocus colordiffuse="overlay">colors/black.png</texturenofocus>
                <ondown>2</ondown>
            </control>
            <control type="panel" id="2">
                <posy>540</posy>
                <width>8_col</width>
                <height>204</height>
                <onup>4</onup>
                <itemlayout width="8_col" height="84">
                    <control type="image">
                        <width>69</width>
                        <height>69</height>
                        <texture fallback="colors/offblack.png">$INFO[listitem.icon]</texture>
                    </control>

                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>7_col</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="8_col" height="84">
                    <control type="image">
                        <posx>1_col</posx>
                        <width>7_col</width>
                        <height>69</height>
                        <texture>colors/white.png</texture>
                    </control>
                    <control type="image">
                        <width>1_col</width>
                        <height>69</height>
                        <texture fallback="colors/white.png">$INFO[listitem.icon]</texture>
                        <colordiffuse>highlight</colordiffuse>
                        <include>spin_focus_icon</include>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>6_col</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <textcolor>black</textcolor>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </focusedlayout>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="SettingsProfile.xml"/></include>
    </controls>
</window>
