<?xml version="1.0" encoding="UTF-8"?>
<!--Invisible helper. Becomes visible when playback ends while the fullscreen music player (1103)
    is open; its only job is to close all dialogs, the player included.-->
<window type="dialog" id="1101">
    <onload>Dialog.Close(all)</onload>
    <visible>Window.IsActive(1103) + !player.playing + !player.paused</visible>
    <controls>
        <include content="debug_overlay"><param name="label" value="custom_musicFullscreenDisabler.xml"/></include>
    </controls>
</window>
