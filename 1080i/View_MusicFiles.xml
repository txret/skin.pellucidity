<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--default text list 1 row-->
    <include name="view_music_files">
        <control type="group">
            <posx>col_1_begin</posx>
            <posy>row_5_begin</posy>
            <control type="panel" id="50">
                <visible>!$EXP[is_music_playlist] + !$EXP[is_music_song] + !$EXP[is_spotify_album] + !$EXP[is_spotify_artist] + !$EXP[is_music_album] + $EXP[is_music_list]</visible>
                <width>24_col</width>
                <height>23_row</height>
                <onleft>9000</onleft>
                <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
                <ondown>50</ondown>
                <onup>50</onup>
                <pagecontrol>60</pagecontrol>
                <include content="layout_file_row"><param name="label_width" value="23_col_gutter"/></include>
            </control>
        </control>
    </include>
</includes>
