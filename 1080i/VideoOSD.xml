<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">8001</defaultcontrol>
    <onload>Control.SetFocus(8001,3)</onload>
    <controls>
        <control type="label">
            <posx>col_1_begin</posx>
            <posy>row_1_begin</posy>
            <width>12_col</width>
            <font>page_title</font>
            <label>$INFO[System.Time]</label>
        </control>
        <control type="label">
            <posx>col_1_begin</posx>
            <posy>96</posy>
            <width>12_col</width>
            <font>page_subtitle</font>
            <label>$INFO[System.Date(DDD)], $INFO[system.Date(mmm d)]</label>
        </control>
        <control type="group">
            <posx>1236</posx>
            <animation type="Windowopen">
                <effect type="fade" start="0" end="100" time="400"/>
                <effect type="slide" start="800" end="0" tween="cubic" easing="out" time="500"/>
            </animation>
            <animation type="windowClose">
                <effect type="fade" start="100" end="0" time="1000"/>
                <effect type="slide" start="0" end="800" tween="cubic" easing="in" time="500"/>
            </animation>
            <!--fade out if audio / video menu active-->
            <animation type="Conditional" condition="Window.IsActive(osdsubtitlesettings) | Window.IsActive(seekbar) | Window.IsActive(osdvideosettings) | Window.IsActive(osdaudiosettings) | window.isactive(PVROSDChannels) | window.isactive(subtitlesearch)">
                <effect type="fade" start="100" end="0" time="350"/>
                <effect type="slide" start="0" end="900" tween="cubic" easing="in" time="500"/>
            </animation>
            <!--overlay-->
            <control type="image">
                <width>12_col</width>
                <height>fullscreen_height</height>
                <texture>colors/black.png</texture>
                <colordiffuse>cc111111</colordiffuse>
            </control>
            <control type="group">
                <posx>36</posx>
                <posy>row_1_begin</posy>
                <control type="grouplist">
                    <itemgap>32</itemgap>
                    <control type="label">
                        <width>8_col</width>
                        <font>item_title</font>
                        <label>$INFO[videoplayer.TVShowTitle]$INFO[VideoPlayer.ChannelName]</label>
                    </control>
                    <control type="label">
                        <width>8_col</width>
                        <height>3_row</height>
                        <font>large_title</font>
                        <wrapmultiline>true</wrapmultiline>
                        <label>$INFO[videoplayer.title]</label>
                    </control>
                </control>
                <!--player position-->
                <control type="group">
                    <posy>6_row</posy>
                    <control type="label">
                        <visible>!Pvr.IsPlayingTv</visible>
                        <width>2_col</width>
                        <font>item_subtitle</font>
                        <textcolor>highlight</textcolor>
                        <label>[B]$LOCALIZE[31143][/B]</label>
                    </control>
                    <control type="label">
                        <visible>!Pvr.IsPlayingTv</visible>
                        <posy>32</posy>
                        <width>6_col</width>
                        <font>item_title</font>
                        <label fallback="13205">[B]$INFO[player.timeremaining][/B]</label>
                    </control>

                    <control type="label">
                        <visible>!Pvr.IsPlayingTv</visible>
                        <posx>3_col_gutter</posx>
                        <width>2_col</width>
                        <font>item_subtitle</font>
                        <textcolor>highlight</textcolor>
                        <label>[B]$LOCALIZE[31245][/B]</label>
                    </control>
                    <control type="label">
                        <visible>!Pvr.IsPlayingTv</visible>
                        <posx>3_col_gutter</posx>
                        <posy>32</posy>
                        <width>6_col</width>
                        <font>item_title</font>
                        <label fallback="13205">[B]$INFO[VideoPlayer.FinishTime][/B]</label>
                    </control>

                    <control type="label">
                        <visible>Pvr.IsPlayingTv</visible>
                        <width>2_col</width>
                        <font>item_subtitle</font>
                        <textcolor>highlight</textcolor>
                        <label>[B]$LOCALIZE[31160][/B]</label>
                    </control>
                    <control type="label">
                        <visible>Pvr.IsPlayingTv</visible>
                        <posy>32</posy>
                        <width>6_col</width>
                        <font>item_title</font>
                        <label fallback="13205">$INFO[VideoPlayer.EndTime]</label>
                    </control>

                    <control type="label">
                        <visible>Pvr.IsPlayingTv</visible>
                        <posx>3_col_gutter</posx>
                        <width>2_col</width>
                        <font>item_subtitle</font>
                        <textcolor>highlight</textcolor>
                        <label>[B]$LOCALIZE[19031][/B]</label>
                    </control>
                    <control type="label">
                        <visible>Pvr.IsPlayingTv</visible>
                        <posx>3_col_gutter</posx>
                        <posy>32</posy>
                        <width>6_col</width>
                        <font>item_title</font>
                        <label fallback="13205">$INFO[VideoPlayer.NextTitle]</label>
                    </control>
                </control>
                <!--synopsis-->
                <control type="textbox">
                    <posy>9_row</posy>
                    <font>textbox</font>
                    <width>612</width>
                    <align>left</align>
                    <height>314</height>
                    <label fallback="31205">$INFO[videoplayer.plot]</label>
                    <autoscroll>false</autoscroll>
                    <pagecontrol>61</pagecontrol>
                </control>
                <control type="scrollbar" id="61">
                    <posx>12r</posx>
                    <posy>9_row</posy>
                    <height>7_row</height>
                    <ondown>8001</ondown>
                </control>
            </control>
            <!--player controls-->
            <control type="panel" id="8001">
                <posx>36</posx>
                <posy>row_21_begin</posy>
                <width>10_col</width>
                <height>2_row</height>
                <ondown>Control.SetFocus(8002,0)</ondown>
                <onup>Control.SetFocus(61)</onup>
                <orientation>horizontal</orientation>
                <itemlayout width="92" height="2_row">
                    <control type="image">
                        <width>1_col</width>
                        <height>2_row</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="label">
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label>$INFO[ListItem.label2]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="92" height="2_row">
                    <control type="image">
                        <width>1_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="label">
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label>$INFO[ListItem.label2]</label>
                    </control>
                </focusedlayout>
                <content>
                    <item>
                        <description>Previous</description>
                        <label2></label2>
                        <onclick>PlayerControl(previous)</onclick>
                    </item>
                    <item>
                        <description>Rewind</description>
                        <label2></label2>
                        <onclick>PlayerControl(rewind)</onclick>
                    </item>
                    <item>
                        <description>Stop</description>
                        <label2></label2>
                        <onclick>PlayerControl(stop)</onclick>
                    </item>
                    <item>
                        <visible>Player.Playing | player.forwarding | player.rewinding</visible>
                        <description>Play/Pause</description>
                        <label2></label2>
                        <onclick>PlayerControl(play)</onclick>
                    </item>
                    <item>
                        <visible>Player.Paused</visible>
                        <description>Pause</description>
                        <label2></label2>
                        <onclick>action(back)</onclick>
                        <onclick>PlayerControl(play)</onclick>
                    </item>
                    <item>
                        <description>Fast forward</description>
                        <label2></label2>
                        <onclick>PlayerControl(forward)</onclick>
                    </item>
                    <item>
                        <description>Next Chapter</description>
                        <label2></label2>
                        <onclick>PlayerControl(next)</onclick>
                    </item>
                    <item>
                        <visible>PVR.CanRecordPlayingChannel</visible>
                        <label2></label2>
                        <onclick>PVR.ToggleRecordPlayingChannel</onclick>
                    </item>
                </content>
            </control>
            <!--menu items-->
            <control type="panel" id="8002">
                <posx>24</posx>
                <posy>row_24_begin</posy>
                <width>9_col</width>
                <height>12_row</height>
                <onup>8001</onup>
                <include content="layout_osd_button"><param name="width" value="324"/><param name="label_width" value="224"/><param name="font" value="item_subtitle"/><param name="focus_width" value="240"/></include>
                <content>
                    <item>
                        <visible>VideoPlayer.HasMenu</visible>
                        <label>31051</label>
                        <label2></label2>
                        <onclick>PlayerControl(ShowVideoMenu)</onclick>
                    </item>
                    <item>
                        <description>Subtitles</description>
                        <label>287</label>
                        <label2></label2>
                        <onclick>ActivateWindow(osdsubtitlesettings)</onclick>
                    </item>
                    <item>
                        <description>Video Settings</description>
                        <label>13395</label>
                        <label2></label2>
                        <onclick>ActivateWindow(osdvideosettings)</onclick>
                    </item>
                    <item>
                        <description>Audio Settings</description>
                        <label>13396</label>
                        <label2></label2>
                        <onclick>ActivateWindow(osdaudiosettings)</onclick>
                    </item>
                    <item>
                        <description>Bookmarks</description>
                        <label>298</label>
                        <label2></label2>
                        <onclick>ActivateWindow(videobookmarks)</onclick>
                    </item>
                </content>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="VideoOSD.xml"/></include>
    </controls>
</window>
