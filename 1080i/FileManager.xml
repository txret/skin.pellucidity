<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">20</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include>mini_video_player</include>
        <control type="group">
            <include content="page_background"><param name="image" value="settings.jpg"/></include>
            <include>modal_dialog_in_out_vertical</include>
            <!--page title-->
            <control type="group">
                <posx>col_4_begin</posx>
                <posy>row_5_begin</posy>
                <control type="image">
                    <posx>-12</posx>
                    <posy>-12</posy>
                    <width>1320</width>
                    <height>732</height>
                    <texture>colors/black.png</texture>
                    <colordiffuse>overlay</colordiffuse>
                </control>
                <include content="dialog_title_bar"><param name="width" value="18_col"/><param name="label" value="10003"/></include>
                <control type="image">
                    <posy>84</posy>
                    <width>18_col</width>
                    <height>71</height>
                    <texture>colors/offblack.png</texture>
                </control>
            </control>
            <!--left panel-->
            <control type="group">
                <posx>col_4_begin</posx>
                <posy>270</posy>
                <control type="label" id="101">
                    <description>Header Label</description>
                    <posx>24</posx>
                    <posy>12</posy>
                    <height>2_row</height>
                    <width>636</width>
                    <font>item_title</font>
                </control>
                <!--page scrollbar-->
                <control type="group" id="8000">
                    <visible>Control.IsVisible(60)</visible>
                    <animation effect="fade" start="100" end="0" time="100" condition="!controlgroup(8000).hasfocus">conditional</animation>
                    <control type="scrollbar" id="60">
                        <posx>-18</posx>
                        <posy>2_row</posy>
                        <height>16_row</height>
                        <onright>20</onright>
                    </control>
                </control>
                <!--left file list-->
                <control type="list" id="20">
                    <posy>96</posy>
                    <width>636</width>
                    <height>540</height>
                    <onright>21</onright>
                    <onleft>60</onleft>
                    <pagecontrol>60</pagecontrol>
                    <include content="layout_file_manager_row"><param name="label_width" value="9_col_gutter"/><param name="focus_width" value="9_col_textbox"/><param name="focus_condition" value="!Control.HasFocus(20)"/></include>
                </control>
            </control>
            <!--right panel-->
            <control type="group">
                <posx>col_13_begin</posx>
                <posy>row_7_begin</posy>
                <control type="label" id="102">
                    <description>Header Label</description>
                    <posx>24</posx>
                    <posy>12</posy>
                    <width>9_col_gutter</width>
                    <height>2_row</height>
                    <font>item_title</font>
                </control>
                <control type="list" id="21">
                    <posy>96</posy>
                    <width>9_col</width>
                    <height>540</height>
                    <onleft>20</onleft>
                    <onright>61</onright>
                    <pagecontrol>61</pagecontrol>
                    <include content="layout_file_manager_row"><param name="label_width" value="636"/><param name="focus_width" value="9_col"/><param name="focus_condition" value="Control.HasFocus(20)"/></include>
                </control>
                <!--page scrollbar-->
                <control type="group" id="8001">
                    <visible>Control.IsVisible(61)</visible>
                    <animation effect="fade" start="100" end="0" time="100" condition="!controlgroup(8001).hasfocus">conditional</animation>
                    <control type="scrollbar" id="61">
                        <posx>654</posx>
                        <posy>2_row</posy>
                        <height>16_row</height>
                        <onleft>21</onleft>
                    </control>
                </control>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="FileManager.xml"/></include>
    </controls>
</window>
