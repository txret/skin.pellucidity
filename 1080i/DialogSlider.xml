<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">11</defaultcontrol>
    <controls>
        <control type="group">
            <include>toast_position</include>
            <animation type="Windowclose">
                <effect type="fade" start="100" end="0" time="400" tween="sine"/>
            </animation>
            <control type="group">
                <animation type="Windowopen">
                    <effect type="slide" start="1000,0" end="0,0" time="400" tween="sine"/>
                </animation>
                <include>toast_card</include>
            </control>
            <control type="label" id="10">
                <description>heading</description>
                <include>toast_heading</include>
                <animation type="Windowopen">
                    <effect type="fade" start="0" end="100" delay="400" time="400" tween="sine"/>
                </animation>
            </control>
            <control type="label" id="12">
                <description>message</description>
                <include>toast_message</include>
                <scroll>true</scroll>
                <scrollspeed>100</scrollspeed>
                <animation type="Windowopen">
                    <effect type="fade" start="0" end="100" delay="600" time="400" tween="sine"/>
                </animation>
            </control>
            <control type="slider" id="11">
                <description>Slider</description>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogSlider.xml"/></include>
    </controls>
</window>
