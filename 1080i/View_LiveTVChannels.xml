<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--TV / radio channels (view 50): one row per channel with what is on now and next.-->
    <include name="view_live_tv_channels">
        <control type="group">
            <control type="panel" id="50">
                <posx>col_1_begin</posx>
                <posy>row_5_begin</posy>
                <width>24_col</width>
                <height>23_row</height>
                <onleft>9000</onleft>
                <onright>60</onright>
                <onback>activateWindow(home)</onback>
                <ondown>50</ondown>
                <onup>50</onup>
                <pagecontrol>60</pagecontrol>
                <scrolltime tween="cubic" easing="out">400</scrolltime>
                <itemlayout height="2_row" width="24_col">
                    <control type="image">
                        <posx>1_col</posx>
                        <width>23_col</width>
                        <height>69</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="image">
                        <posy>3</posy>
                        <width>66</width>
                        <height>66</height>
                        <aspectratio>keep</aspectratio>
                        <texture fallback="colors/black.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>288</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <posx>5_col_gutter</posx>
                        <width>160</width>
                        <height>2_row</height>
                        <align>right</align>
                        <font>item_title</font>
                        <label>[B]$INFO[ListItem.starttime][/B]</label>
                    </control>
                    <control type="label">
                        <posx>520</posx>
                        <width>7_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="label">
                        <posx>14_col_gutter</posx>
                        <width>160</width>
                        <height>2_row</height>
                        <align>right</align>
                        <font>item_title</font>
                        <label>[B]$INFO[ListItem.nextstarttime][/B]</label>
                    </control>
                    <control type="label">
                        <posx>1168</posx>
                        <width>7_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.nextTitle]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="2_row" width="20_col">
                    <control type="image">
                        <posx>1_col</posx>
                        <width>23_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="image">
                        <posy>3</posy>
                        <width>66</width>
                        <height>66</height>
                        <aspectratio>keep</aspectratio>
                        <texture fallback="colors/black.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                        <include>spin_focus_thumb</include>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <width>288</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <posx>5_col_gutter</posx>
                        <width>160</width>
                        <height>2_row</height>
                        <align>right</align>
                        <font>item_title</font>
                        <label>[B]$INFO[ListItem.starttime][/B]</label>
                    </control>
                    <control type="label">
                        <posx>520</posx>
                        <width>7_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.Title]</label>
                    </control>
                    <control type="label">
                        <posx>14_col_gutter</posx>
                        <width>160</width>
                        <height>2_row</height>
                        <align>right</align>
                        <font>item_title</font>
                        <label>[B]$INFO[ListItem.nextstarttime][/B]</label>
                    </control>
                    <control type="label">
                        <posx>1168</posx>
                        <width>7_col_gutter</width>
                        <height>2_row</height>
                        <font>item_title</font>
                        <label>$INFO[ListItem.nextTitle]</label>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </include>
</includes>
