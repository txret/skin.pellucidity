<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9999</defaultcontrol>
    <onload condition="Skin.hassetting(stopVideoOnMenu) + !Player.HasAudio">PlayerControl(stop)</onload>
    <onload condition="String.Contains(container.folderpath,plugin://)">Container.SetViewMode(54)</onload>
    <include>fade_in_out</include>
    <views>50,51,52,53,54,55,58,59</views>
    <controls>
        <include content="page_background" condition="$EXP[is_movie]"><param name="image" value="movie.jpg"/></include>
        <include content="page_background" condition="!$EXP[is_movie]"><param name="image" value="tv.jpg"/></include>
        <!--page container group-->
        <control type="group">
            <include>modal_dialog_content_shift</include>
            <!--Main content listing-->
            <control type="group" id="9999">
                <include>content_open</include>
                <!--source content-->
                <control type="group" id="9500">
                    <include>view_video_files</include>
                    <include>view_movies</include>
                    <include>view_addon_posters</include>
                    <include>view_tvshows</include>
                    <include>view_seasons</include>
                    <include>view_episodes</include>
                    <include>view_music_videos</include>
                </control>
            </control>
            <include>jump</include>
            <include>page_header</include>
        </control>
        <include>mini_video_player</include>
        <include>hub_menu</include>
        <include>loading_indicator</include>
        <include content="debug_overlay"><param name="label" value="MyVideoNav.xml path: $INFO[container.folderpath] folder: $INFO[container.foldername] content: $INFO[container.content]"/></include>
    </controls>
</window>
