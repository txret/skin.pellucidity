<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--Poster wall (view 54) for movies and shows listed by a video plugin. The focused item's
        fanart fills the background; the ".." item shows its icon instead of a poster.-->
    <include name="view_addon_posters">
        <control type="group">
            <include content="page_background"><param name="image" value="settings.jpg"/></include>
            <visible>$EXP[is_addon_movie_or_tvshow]</visible>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <texture>$VAR[list_fanart]</texture>
                <colordiffuse>FF555555</colordiffuse>
                <aspectratio>scale</aspectratio>
                <fadetime>250</fadetime>
            </control>
            <control type="panel" id="54">
                <visible>$EXP[is_addon_movie_or_tvshow]</visible>
                <posx>90</posx>
                <posy>row_5_begin</posy>
                <width>1800</width>
                <height>23_row</height>
                <onleft>9000</onleft>
                <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
                <ondown>54</ondown>
                <onup>54</onup>
                <pagecontrol>60</pagecontrol>
                <scrolltime tween="cubic" easing="out">600</scrolltime>
                <itemlayout width="252" height="438">
                    <control type="image">
                        <visible>!ListItem.IsParentFolder</visible>
                        <width>228</width>
                        <height>342</height>
                        <texture>colors/black.png</texture>
                        <bordersize>6</bordersize>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="image">
                        <width>228</width>
                        <height>342</height>
                        <texture>$INFO[ListItem.Art(poster)]</texture>
                        <aspectratio>scale</aspectratio>
                        <bordersize>6</bordersize>
                    </control>
                    <control type="image">
                        <visible>ListItem.IsParentFolder</visible>
                        <posx>6</posx>
                        <posy>43</posy>
                        <width>216</width>
                        <height>216</height>
                        <aspectratio>keep</aspectratio>
                        <texture>$INFO[ListItem.Icon]</texture>
                        <colordiffuse>99ffffff</colordiffuse>
                    </control>
                    <control type="label">
                        <visible>!controlgroup(9000).hasfocus</visible>
                        <posx>12</posx>
                        <posy>350</posy>
                        <width>204</width>
                        <font>thumb_title</font>
                        <label>[B]$INFO[ListItem.title][/B][CR]$INFO[ListItem.year]</label>
                    </control>
                    <control type="group">
                        <visible>String.IsEmpty(ListItem.PlayCount) + !ListItem.IsParentFolder</visible>
                        <animation condition="true" effect="fade" end="70" time="0">conditional</animation>
                        <posx>166</posx>
                        <posy>6</posy>
                        <control type="image">
                            <width>56</width>
                            <height>56</height>
                            <texture>masks/newContent.png</texture>
                            <colordiffuse>highlight</colordiffuse>
                        </control>
                        <control type="label">
                            <posx>28</posx>
                            <posy>-4</posy>
                            <width>36</width>
                            <font>symbol</font>
                            <label></label>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout width="252" height="438">
                    <control type="group">
                        <include>focus_thumb</include>
                        <control type="image">
                            <visible>!ListItem.IsParentFolder</visible>
                            <width>228</width>
                            <height>342</height>
                            <texture>colors/black.png</texture>
                            <bordertexture colordiffuse="FFFFFFFF">colors/white.png</bordertexture>
                            <bordersize>6</bordersize>
                            <colordiffuse>FF000000</colordiffuse>
                        </control>
                        <control type="image">
                            <width>228</width>
                            <height>342</height>
                            <texture>$INFO[ListItem.Art(poster)]</texture>
                            <aspectratio>scale</aspectratio>
                            <bordersize>6</bordersize>
                        </control>
                        <control type="image">
                            <visible>ListItem.IsParentFolder</visible>
                            <posx>6</posx>
                            <posy>43</posy>
                            <width>216</width>
                            <height>216</height>
                            <aspectratio>keep</aspectratio>
                            <texture>$INFO[ListItem.Icon]</texture>
                        </control>
                        <control type="label">
                            <posx>12</posx>
                            <posy>354</posy>
                            <width>204</width>
                            <font>thumb_title</font>
                            <label>[B]$INFO[ListItem.title][/B][CR]$INFO[ListItem.year]</label>
                        </control>
                        <control type="group">
                            <visible>String.IsEmpty(ListItem.PlayCount) + !ListItem.IsParentFolder</visible>
                            <posx>166</posx>
                            <posy>6</posy>
                            <control type="image">
                                <width>56</width>
                                <height>56</height>
                                <texture>masks/newContent.png</texture>
                                <colordiffuse>highlight</colordiffuse>
                            </control>
                            <control type="label">
                                <posx>28</posx>
                                <posy>-4</posy>
                                <width>36</width>
                                <font>symbol</font>
                                <label></label>
                            </control>
                        </control>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </include>
</includes>
