<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--Music genre browser-->
    <include name="view_music_genres">
        <control type="panel" id="55">
            <visible>$EXP[is_music_genre]</visible>
            <posx>col_1_begin</posx>
            <posy>row_5_begin</posy>
            <width>24_col</width>
            <height>23_row</height>
            <onleft>9000</onleft>
            <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
            <ondown>55</ondown>
            <onup>55</onup>
            <pagecontrol>60</pagecontrol>
            <itemlayout width="8_col" height="2_row">
                <control type="image">
                    <posy>3</posy>
                    <width>66</width>
                    <height>66</height>
                    <aspectratio scalediffuse="false">stretch</aspectratio>
                    <texture fallback="colors/black.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                    <colordiffuse>overlay</colordiffuse>
                </control>
                <control type="label">
                    <posx>1_col_indent</posx>
                    <width>6_col</width>
                    <height>2_row</height>
                    <font>item_title</font>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="8_col" height="2_row">
                <control type="image">
                    <posx>1_col</posx>
                    <width>7_col_gutter</width>
                    <height>2_row</height>
                    <texture>colors/white.png</texture>
                    <colordiffuse>highlight</colordiffuse>
                </control>
                <control type="image">
                    <posy>3</posy>
                    <width>66</width>
                    <height>66</height>
                    <aspectratio scalediffuse="false">stretch</aspectratio>
                    <texture fallback="colors/black.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                    <include>spin_focus_thumb</include>
                </control>
                <control type="label">
                    <posx>1_col_indent</posx>
                    <width>6_col</width>
                    <height>2_row</height>
                    <font>item_title</font>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>
    </include>
</includes>
