                <itemlayout width="5_col" height="2_row">
                    <control type="label">
                        <width>324</width>
                        <font>item_subtitle</font>
                        <textcolor>highlight</textcolor>
                        <label>[B]$INFO[ListItem.label][/B]</label>
                    </control>
                    <control type="label">
                        <posy>32</posy>
                        <width>324</width>
                        <font>item_subtitle</font>
                        <label fallback="13205">$INFO[ListItem.label2]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="5_col" height="2_row">
                </focusedlayout>
            </control>
