<?xml version="1.0" encoding="UTF-8"?>
<!--Home: main menu tiles (9000, filled by Skin Shortcuts) over a slowly changing photo, with
    clock, date and weather above and the power button (9001) below. After 20s without input
    focus moves to the off-screen button 9999, which fades the menu out so only the photo and
    the clock remain; any key brings the menu back.-->
<window id="0">
    <defaultcontrol always="true">9000</defaultcontrol>
    <onload condition="Skin.hassetting(stopVideoOnMenu) + !Player.HasAudio">PlayerControl(stop)</onload>
    <onload>AlarmClock(hide_menu,setfocus(9999),00:20,true)</onload>
    <onunload>CancelAlarm(hide_menu,true)</onunload>
    <!--rotating background ("persistent multiimage"): the chosen path lives in Window(home).Property(home_background),
        so coming back to Home keeps the same photo; pick one only if none yet, then a new one every 30s-->
    <onload condition="String.IsEmpty(Window(home).Property(home_background))">RunScript(special://skin/scripts/cycle_background.py, special://skin/media/home_backgrounds, home_background)</onload>
    <onload>AlarmClock(cycle_home_background, RunScript(special://skin/scripts/cycle_background.py, special://skin/media/home_backgrounds, home_background), 00:30, silent, loop)</onload>
    <onunload>CancelAlarm(cycle_home_background, true)</onunload>
    <controls>
        <control type="group">
            <animation type="conditional" condition="control.hasfocus(8001)">
                <effect type="slide" start="0,0" end="0,-80" tween="sine" time="400"/>
            </animation>
            <!--player controls and options-->
            <control type="group">
                <posy>1080</posy>
                <control type="image">
                    <width>fullscreen_width</width>
                    <height>3_row</height>
                    <texture>colors/black.png</texture>
                </control>
                <!--player controls-->
                <control type="panel" id="8001">
                    <posx>col_1_begin</posx>
                    <posy>6</posy>
                    <width>7_col</width>
                    <height>2_row</height>
                    <onleft>8001</onleft>
                    <onright>8001</onright>
                    <onup>9001</onup>
                    <orientation>horizontal</orientation>
                    <include>layout_player_symbol</include>
                    <content>
                        <item>
                            <description>Playlist</description>
                            <label2>&#xF111;</label2>
                            <onclick>activateWindow(musicplaylist)</onclick>
                        </item>
                        <item>
                            <description>Previous</description>
                            <label2>&#xF18B;</label2>
                            <onclick>PlayerControl(previous)</onclick>
                        </item>
                        <item>
                            <description>Stop</description>
                            <label2>&#xF185;</label2>
                            <onclick>PlayerControl(stop)</onclick>
                            <onclick>Dialog.Close(1103)</onclick>
                        </item>
                        <item>
                            <visible>Player.Playing | player.forwarding | player.rewinding</visible>
                            <description>Play/Pause</description>
                            <label2>&#xF186;</label2>
                            <onclick>PlayerControl(play)</onclick>
                        </item>
                        <item>
                            <visible>Player.Paused</visible>
                            <description>Pause</description>
                            <label2>&#xF184;</label2>
                            <onclick>PlayerControl(play)</onclick>
                        </item>
                        <item>
                            <description>Next Chapter</description>
                            <label2>&#xF18A;</label2>
                            <onclick>PlayerControl(next)</onclick>
                        </item>
                    </content>
                </control>
            </control>
            <!--background photo, two identical layers (same texture, decoded once): the lower one appears
                instantly when Home opens, the upper one crossfades when the photo changes. Its fade-in on
                window open is invisible over the lower copy, so returning to Home never fades from black.
                ff999999 = opaque 60% dim (looks like the old 99ffffff over black, but stacks without brightening)-->
            <control type="image">
                <include>dimensions_fullscreen</include>
                <aspectratio>scale</aspectratio>
                <texture>$INFO[Window(home).Property(home_background)]</texture>
                <colordiffuse>ff999999</colordiffuse>
            </control>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <aspectratio>scale</aspectratio>
                <texture>$INFO[Window(home).Property(home_background)]</texture>
                <fadetime>500</fadetime>
                <colordiffuse>ff999999</colordiffuse>
            </control>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <texture>vignette.png</texture>
            </control>
            <include>mini_video_player</include>
            <!--main menu-->
            <control type="panel" id="9000">
                <animation type="conditional" condition="control.hasfocus(9999)">
                    <effect type="fade" start="100" end="0" time="500"/>
                </animation>
                <posx>col_3_begin</posx>
                <animation condition="string.isEqual(Container(9000).NumItems,1)" effect="slide" end="432,0" time="0">conditional</animation>
                <animation condition="string.isEqual(Container(9000).NumItems,2)" effect="slide" end="288,0" time="0">conditional</animation>
                <animation condition="string.isEqual(Container(9000).NumItems,3)" effect="slide" end="144,0" time="0">conditional</animation>
                <posy>row_11_begin</posy>
                <width>22_col</width>
                <height>12_row</height>
                <ondown>setfocus(9001,1)</ondown>
                <itemlayout width="4_col" height="3_row">
                    <control type="image">
                        <width>4_col_textbox</width>
                        <height>105</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>77000000</colordiffuse>
                    </control>
                    <control type="textbox">
                        <posx>12</posx>
                        <width>252</width>
                        <height>3_row</height>
                        <font>dialog_title</font>
                        <aligny>center</aligny>
                        <align>center</align>
                        <label>[CAPITALIZE]$INFO[ListItem.label][/CAPITALIZE]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="4_col" height="3_row">
                    <control type="image">
                        <width>4_col_textbox</width>
                        <height>105</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="textbox">
                        <posx>12</posx>
                        <width>252</width>
                        <height>3_row</height>
                        <font>dialog_title</font>
                        <aligny>center</aligny>
                        <align>center</align>
                        <label>[CAPITALIZE]$INFO[ListItem.label][/CAPITALIZE]</label>
                    </control>
                </focusedlayout>
                <content>
                    <include>skinshortcuts-mainmenu</include>
                </content>
            </control>
            <!--power menu button, centred below the main menu-->
            <control type="panel" id="9001">
                <posx>938</posx>
                <posy>972</posy>
                <width>4_col</width>
                <height>1_col</height>
                <orientation>horizontal</orientation>
                <onup>9000</onup>
                <ondown>8001</ondown>
                <itemlayout width="1_col" height="1_col">
                    <control type="label">
                        <posy>-1</posy>
                        <width>1_col</width>
                        <height>1_col</height>
                        <font>symbol_large</font>
                        <align>center</align>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="1_col" height="1_col">
                    <control type="image">
                        <width>1_col</width>
                        <height>1_col</height>
                        <texture diffuse="masks/circle.png">colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                    </control>
                    <control type="label">
                        <posy>-1</posy>
                        <width>1_col</width>
                        <height>1_col</height>
                        <font>symbol_large</font>
                        <align>center</align>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </focusedlayout>
                <content>
                    <item>
                        <label>&#xF48A;</label>
                        <onclick>ActivateWindow(shutdownmenu)</onclick>
                    </item>
                </content>
            </control>
            <!--Date / time and weather-->
            <control type="group">
                <posx>col_1_begin</posx>
                <posy>row_6_begin</posy>
                <animation type="conditional" condition="control.hasfocus(9999) + !player.hasaudio">
                    <effect type="slide" start="0,0" end="0,608" time="200"/>
                </animation>
                <animation type="conditional" condition="control.hasfocus(9999) + player.hasaudio">
                    <effect type="slide" start="0,0" end="0,554" time="200"/>
                </animation>
                <control type="label">
                    <posy>-48</posy>
                    <width>24_col</width>
                    <height>2_row</height>
                    <align>center</align>
                    <font>very_large</font>
                    <shadowcolor>44000000</shadowcolor>
                    <label>$INFO[System.Time]</label>
                </control>
                <control type="label">
                    <visible>$EXP[has_weather]</visible>
                    <posy>1_row</posy>
                    <width>24_col</width>
                    <height>2_row</height>
                    <align>center</align>
                    <shadowcolor>44000000</shadowcolor>
                    <label>$INFO[System.Date(DDD)] [B]$INFO[System.Date(dd)][/B] $INFO[System.Date(MMM)] [B]$INFO[Weather.Temperature][/B] [CAPITALIZE]$INFO[Weather.Conditions][/CAPITALIZE]</label>
                </control>
                <control type="label">
                    <visible>!$EXP[has_weather]</visible>
                    <posy>1_row</posy>
                    <width>24_col</width>
                    <height>2_row</height>
                    <align>center</align>
                    <shadowcolor>44000000</shadowcolor>
                    <label>$INFO[System.Date(DDD)] [B]$INFO[System.Date(dd)][/B] $INFO[System.Date(MMM)]</label>
                </control>
            </control>
            <!--now playing music-->
            <control type="group">
                <visible>player.hasaudio</visible>
                <posx>col_1_begin</posx>
                <posy>row_24_begin</posy>
                <control type="grouplist">
                    <posy>8</posy>
                    <width>24_col</width>
                    <align>center</align>
                    <itemgap>18</itemgap>
                    <orientation>horizontal</orientation>
                    <control type="image">
                        <visible>!player.paused + !Skin.HasSetting(lowPowerMode)</visible>
                        <width>1_col_gutter</width>
                        <height>1_col_gutter</height>
                        <texture>equaliser.gif</texture>
                    </control>
                    <control type="label">
                        <visible>!player.paused + Skin.HasSetting(lowPowerMode)</visible>
                        <width>1_col_gutter</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label>&#xF184;</label>
                    </control>
                    <control type="label">
                        <visible>player.paused</visible>
                        <width>1_col_gutter</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label>&#xF186;</label>
                    </control>
                    <control type="label">
                        <description>Artist</description>
                        <font>small</font>
                        <width>auto</width>
                        <height>2_row</height>
                        <align>center</align>
                        <label>$INFO[MusicPlayer.TimeRemaining,, ][B]$INFO[musicplayer.Artist,, ][/B]$INFO[MusicPlayer.Title]</label>
                        <scroll>true</scroll>
                        <wrapmultiline>false</wrapmultiline>
                    </control>
                </control>
            </control>
        </control>
        <control type="button" id="9999">
            <posx>-500</posx>
            <width>1_col</width>
            <onleft>setfocus(9000,0)</onleft>
            <onright>setfocus(9000,0)</onright>
            <onup>setfocus(9000,0)</onup>
            <ondown>setfocus(9000,0)</ondown>
            <onclick>setfocus(9000,0)</onclick>
        </control>
        <include content="debug_overlay"><param name="label" value="Home.xml"/></include>
    </controls>
</window>
