<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">8000</defaultcontrol>
    <include>fade_in_out</include>
    <animation type="windowClose">
        <effect type="fade" start="100" end="0" time="400" delay="400"/>
    </animation>
    <controls>
        <!--fanart / coverart if available-->
        <control type="group">
            <include content="page_background"><param name="image" value="music.png"/></include>
            <!--fanart-->
            <control type="image">
                <visible>!container.content(albums)</visible>
                <posx>0</posx>
                <posy>0</posy>
                <include>dimensions_fullscreen</include>
                <aspectratio align="center" aligny="top">stretch</aspectratio>
                <texture>$INFO[Listitem.art(fanart)]</texture>
                <include>ken_burns</include>
            </control>
            <!--coverart-->
            <control type="group">
                <visible>container.content(albums)</visible>
                <posx>3_col</posx>
                <posy>2_row</posy>
                <control type="image">
                    <width>12_col</width>
                    <height>12_col</height>
                    <aspectratio align="center" aligny="top">stretch</aspectratio>
                    <texture fallback="noAlbumCover.jpg">$INFO[Listitem.thumb]</texture>
                    <animation effect="rotateY" end="-7" center="auto,auto" time="500">windowOpen</animation>
                    <animation type="windowClose">
                        <effect type="rotateY" start="-7" end="0" center="auto,auto" time="500"/>
                        <effect type="slide" start="0" end="-1100" tween="cubic" easing="out" time="400"/>
                    </animation>
                </control>
                <control type="image">
                    <posy>12_col</posy>
                    <width>12_col</width>
                    <height>2_col</height>
                    <aspectratio align="center" aligny="top">scale</aspectratio>
                    <texture fallback="colors/black.png" diffuse="masks/thumbFader.png" flipy="true">$INFO[Listitem.thumb]</texture>
                    <animation type="windowOpen">
                        <effect type="rotateY" end="-7" center="auto,auto" time="500"/>
                    </animation>
                    <animation type="windowClose">
                        <effect type="rotateY" start="-7" end="0" center="auto,auto" time="500"/>
                        <effect type="slide" start="0" end="-1100" tween="cubic" easing="out" time="400"/>
                    </animation>
                </control>
            </control>
            <!--vignette-->
            <control type="image">
                <posx>0</posx>
                <posy>0</posy>
                <include>dimensions_fullscreen</include>
                <texture>vignette.png</texture>
            </control>
        </control>
        <!--content is artist-->
        <control type="group">
            <visible>container.content(artists)</visible>
            <posx>1200</posx>
            <animation type="Windowopen">
                <effect type="fade" start="0" end="100" time="300" delay="300"/>
                <effect type="slide" start="800" end="0" tween="cubic" easing="out" time="400" delay="300"/>
            </animation>
            <animation type="windowClose">
                <effect type="fade" start="100" end="0" time="350"/>
                <effect type="slide" start="0" end="900" tween="cubic" easing="out" time="400"/>
            </animation>
            <control type="image">
                <width>10_col</width>
                <height>fullscreen_height</height>
                <texture>colors/black.png</texture>
                <colordiffuse>cc111111</colordiffuse>
            </control>
            <!--content description-->
            <control type="label">
                <posx>24</posx>
                <posy>66</posy>
                <width>7_col</width>
                <height>115</height>
                <font>large_title</font>
                <label>$INFO[listitem.artist]</label>
                <wrapmultiline>true</wrapmultiline>
            </control>
            <!--synopsis-->
            <control type="textbox">
                <posx>24</posx>
                <posy>row_6_begin</posy>
                <font>textbox</font>
                <width>660</width>
                <align>left</align>
                <height>390</height>
                <label fallback="31205">$INFO[ListItem.Property(Artist_Description)]</label>
                <autoscroll>false</autoscroll>
                <pagecontrol>61</pagecontrol>
            </control>
            <control type="scrollbar" id="61">
                <posx>12r</posx>
                <posy>246</posy>
                <height>10_row</height>
                <ondown>8000</ondown>
            </control>
            <!--meta-->
            <control type="panel">
                <posx>12</posx>
                <posy>18_row</posy>
                <width>10_col</width>
                <height>6_row</height>
                <enable>false</enable>
                <include content="layout_info_text_row"><param name="height" value="78"/></include>
                <content>
                    <item>
                        <label>$LOCALIZE[21894]</label>
                        <label2>$INFO[ListItem.Property(Artist_Formed)]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[515]</label>
                        <label2>$INFO[ListItem.Property(Artist_Genre)]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[21898]</label>
                        <label2>$INFO[ListItem.Property(Artist_YearsActive)]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[180]</label>
                        <label2>$INFO[ListItem.Property(Artist_Style)]</label2>
                    </item>
                </content>
            </control>
            <!--dialog controls-->
            <control type="panel" id="8000">
                <posx>12</posx>
                <posy>row_25_begin</posy>
                <width>10_col</width>
                <height>4_row</height>
                <onup>61</onup>
                <include content="layout_info_button"><param name="bg_color" value="textbox_inactive"/><param name="label_width" value="4_col_gutter"/><param name="focus_label_width" value="3_col_gutter"/></include>
                <content>
                    <item>
                        <label>184</label>
                        <label2></label2>
                        <onclick>SendClick(6)</onclick>
                    </item>
                    <item>
                        <label>13405</label>
                        <label2></label2>
                        <onclick>SendClick(10)</onclick>
                    </item>
                    <item>
                        <label>20413</label>
                        <label2></label2>
                        <onclick>SendClick(12)</onclick>
                    </item>
                    <item>
                        <label>31169</label>
                        <label2></label2>
                        <onclick>SendClick(7)</onclick>
                    </item>
                </content>
            </control>
        </control>
        <!--content is album-->
        <control type="group">
            <visible>container.content(albums) + !container.content(artists)</visible>
            <posx>1200</posx>
            <animation type="Windowopen">
                <effect type="fade" start="0" end="100" time="300" delay="300"/>
                <effect type="slide" start="800" end="0" tween="cubic" easing="out" time="400" delay="300"/>
            </animation>
            <animation type="windowClose">
                <effect type="fade" start="100" end="0" time="350"/>
                <effect type="slide" start="0" end="900" tween="cubic" easing="out" time="400"/>
            </animation>
            <control type="image">
                <width>10_col</width>
                <height>fullscreen_height</height>
                <texture>colors/black.png</texture>
                <colordiffuse>cc111111</colordiffuse>
            </control>
            <!--title and synopsis-->
            <control type="group">
                <posx>24</posx>
                <posy>row_1_begin</posy>
                <control type="grouplist">
                    <itemgap>24</itemgap>
                    <control type="label">
                        <width>8_col</width>
                        <font>item_title</font>
                        <label>$INFO[listitem.artist]</label>
                    </control>
                    <control type="label">
                        <width>8_col</width>
                        <height>3_row</height>
                        <font>large_title</font>
                        <wrapmultiline>true</wrapmultiline>
                        <label>$INFO[listitem.album]</label>
                    </control>
                </control>
                <!--synopsis-->
                <control type="textbox">
                    <posy>row_5_begin</posy>
                    <font>textbox</font>
                    <width>660</width>
                    <align>left</align>
                    <height>390</height>
                    <label fallback="31205">$INFO[ListItem.Property(Album_Description)]</label>
                    <autoscroll>false</autoscroll>
                    <pagecontrol>61</pagecontrol>
                </control>
                <control type="scrollbar" id="61">
                    <posx>12r</posx>
                    <posy>216</posy>
                    <height>10_row</height>
                    <ondown>8000</ondown>
                </control>
                <!--meta-->
                <control type="panel">
                    <posx>-12</posx>
                    <posy>18_row</posy>
                    <width>10_col</width>
                    <height>6_row</height>
                    <enable>false</enable>
                    <include content="layout_info_text_row"><param name="height" value="78"/></include>
                    <content>
                        <item>
                            <label>$LOCALIZE[31149]</label>
                            <label2>$INFO[ListItem.Year]</label2>
                        </item>
                        <item>
                            <label>$LOCALIZE[21899]</label>
                            <label2>$INFO[ListItem.Property(Album_Label)]</label2>
                        </item>
                        <item>
                            <label>$LOCALIZE[515]</label>
                            <label2>$INFO[ListItem.Genre]</label2>
                        </item>
                        <item>
                            <label>$LOCALIZE[736]</label>
                            <label2>$INFO[ListItem.Property(Album_Style)]</label2>
                        </item>
                    </content>
                </control>
            </control>
            <!--dialog controls-->
            <control type="panel" id="8000">
                <posx>12</posx>
                <posy>row_25_begin</posy>
                <width>10_col</width>
                <height>6_row</height>
                <onup>61</onup>
                <include content="layout_info_button"><param name="bg_color" value="overlay"/><param name="label_width" value="3_col_gutter"/><param name="focus_label_width" value="3_col_gutter"/></include>
                <content>
                    <item>
                        <label>184</label>
                        <label2></label2>
                        <onclick>SendClick(6)</onclick>
                    </item>
                    <item>
                        <label>13405</label>
                        <label2></label2>
                        <onclick>SendClick(10)</onclick>
                    </item>
                    <item>
                        <label>20413</label>
                        <label2></label2>
                        <onclick>SendClick(12)</onclick>
                    </item>
                    <item>
                        <label>31169</label>
                        <label2></label2>
                        <onclick>SendClick(7)</onclick>
                    </item>
                </content>
            </control>
        </control>
        <!--content is a song-->
        <control type="group">
            <visible>container.content(songs)</visible>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <texture>colors/black.png</texture>
                <colordiffuse>e9FFFFFF</colordiffuse>
            </control>
            <control type="image">
                <posx>0</posx>
                <posy>0</posy>
                <include>dimensions_fullscreen</include>
                <texture>vignette.png</texture>
            </control>
            <!--content-->
            <control type="group">
                <posx>col_7_begin</posx>
                <posy>row_5_begin</posy>
                <include>modal_dialog_in_out</include>
                <!--titles-->
                <control type="label">
                    <description>Song title</description>
                    <width>12_col_gutter</width>
                    <height>3_row</height>
                    <font>large_title</font>
                    <label>$INFO[ListItem.title]</label>
                    <wrapmultiline>true</wrapmultiline>
                </control>
                <!--col 1-->
                <control type="label">
                    <posy>4_row</posy>
                    <width>6_col_gutter</width>
                    <font>item_title</font>
                    <label>[COLOR highlight]$LOCALIZE[557][/COLOR] $INFO[ListItem.artist]</label>
                </control>
                <control type="label">
                    <posy>5_row</posy>
                    <width>6_col_gutter</width>
                    <font>item_title</font>
                    <label>[COLOR highlight]$LOCALIZE[562][/COLOR] $INFO[ListItem.year]</label>
                </control>
                <control type="label">
                    <posy>6_row</posy>
                    <width>6_col_gutter</width>
                    <font>item_title</font>
                    <label>[COLOR highlight]$LOCALIZE[180][/COLOR] $INFO[ListItem.duration]</label>
                </control>
                <!--col 2-->
                <control type="label">
                    <posx>6_col</posx>
                    <posy>4_row</posy>
                    <width>6_col_gutter</width>
                    <font>item_title</font>
                    <label>[COLOR highlight]$LOCALIZE[558][/COLOR] $INFO[ListItem.album]</label>
                </control>
                <control type="label">
                    <posx>6_col</posx>
                    <posy>5_row</posy>
                    <width>6_col_gutter</width>
                    <font>item_title</font>
                    <label>[COLOR highlight]$LOCALIZE[515][/COLOR] $INFO[ListItem.genre]</label>
                </control>
                <control type="label">
                    <posx>6_col</posx>
                    <posy>6_row</posy>
                    <width>6_col_gutter</width>
                    <font>item_title</font>
                    <label>[COLOR highlight]$LOCALIZE[563][/COLOR] $INFO[ListItem.UserRating]</label>
                </control>
                <!--synopsis-->
                <control type="textbox">
                    <posy>8_row</posy>
                    <font>textbox</font>
                    <width>12_col</width>
                    <align>left</align>
                    <height>200</height>
                    <label>$INFO[ListItem.Property(Album_Description)]</label>
                    <autoscroll delay="10000" time="1000" repeat="10000"/>
                </control>
                <!--dialog controls-->
                <control type="list" id="8000">
                    <posy>16_row</posy>
                    <width>12_col</width>
                    <height>2_row</height>
                    <orientation>horizontal</orientation>
                    <include content="layout_info_button_list"><param name="width" value="4_col"/><param name="label_width" value="3_col"/><param name="focus_width" value="3_col"/></include>
                    <content>
                        <item id="1">
                            <label>208</label>
                            <label2></label2>
                            <onclick>dialog.close(all,true)</onclick>
                            <onclick>action(select)</onclick>
                        </item>
                        <item id="2">
                            <label>31169</label>
                            <label2></label2>
                            <onclick>SendClick(2003,7)</onclick>
                        </item>
                        <item id="3">
                            <label>13511</label>
                            <label2></label2>
                            <onclick>SendClick(2003,10)</onclick>
                        </item>
                    </content>
                </control>
            </control>
        </control>
        <!--dialog controls-->
        <control type="group">
            <visible>false</visible>
            <control type="button" id="6">
                <description>Refresh button</description>
                <label>184</label>
            </control>
            <control type="button" id="7">
                <description>Set rating</description>
            </control>
            <control type="button" id="10">
                <description>Get Thumb</description>
                <label>13405</label>
            </control>
            <control type="button" id="12">
                <description>Get Fanart</description>
                <label>20413</label>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogMusicInfo.xml"/></include>
    </controls>
</window>
