<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--Spotify Artist browser-->
    <include name="view_spotify_artists">
        <control type="group">
            <include content="page_background"><param name="image" value="music.png"/></include>
            <visible>$EXP[is_spotify_artist]</visible>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <texture>$INFO[container(56).listitem.art(thumb)]</texture>
                <colordiffuse>FF555555</colordiffuse>
                <aspectratio>scale</aspectratio>
                <fadetime>250</fadetime>
            </control>
            <!--content-->
            <control type="panel" id="56">
                <visible>$EXP[is_spotify_artist]</visible>
                <posx>90</posx>
                <posy>row_5_begin</posy>
                <width>1800</width>
                <height>25_row</height>
                <onleft>9000</onleft>
                <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
                <ondown>56</ondown>
                <onup>56</onup>
                <scrolltime tween="cubic" easing="out">600</scrolltime>
                <pagecontrol>60</pagecontrol>
                <include content="layout_artist_thumb"><param name="shadow" value="99000000"/></include>
            </control>
        </control>
    </include>
</includes>
