<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include content="page_background"><param name="image" value="weather.jpg"/></include>
        <include>page_clock</include>
        <!--current weather (core properties, formatted by Kodi)-->
        <control type="group">
            <posx>col_1_begin</posx>
            <posy>row_5_begin</posy>
            <control type="label">
                <width>24_col</width>
                <height>2_row</height>
                <font>very_large</font>
                <label>$INFO[Weather.Data(Current.Location)]</label>
            </control>
            <control type="label">
                <visible>!String.IsEqual(Weather.Data(Current.Temperature),Weather.Data(Current.FeelsLike))</visible>
                <posy>3_row</posy>
                <width>24_col</width>
                <height>2_row</height>
                <font>large_title</font>
                <label>$INFO[Weather.Data(Current.Temperature)]$INFO[Weather.Data(Current.FeelsLike), (feels like ,)] [LOWERCASE]$INFO[Weather.Data(Current.Condition)][/LOWERCASE]</label>
            </control>
            <control type="label">
                <visible>String.IsEqual(Weather.Data(Current.Temperature),Weather.Data(Current.FeelsLike))</visible>
                <posy>3_row</posy>
                <width>24_col</width>
                <height>2_row</height>
                <font>large_title</font>
                <label>$INFO[Weather.Data(Current.Temperature)] [LOWERCASE]$INFO[Weather.Data(Current.Condition)][/LOWERCASE]</label>
            </control>
            <control type="label">
                <posy>5_row</posy>
                <width>24_col</width>
                <height>2_row</height>
                <label>$VAR[weather_current_details]</label>
            </control>
        </control>
        <!--forecast: one page per day; up/down picks the day (container 100)-->
        <control type="group">
            <posx>col_1_begin</posx>
            <posy>row_13_begin</posy>
            <control type="label">
                <width>12_col</width>
                <height>2_row</height>
                <font>large</font>
                <label>$INFO[Container(100).ListItem.Label]</label>
            </control>
            <control type="image">
                <posy>78</posy>
                <width>30</width>
                <height>30</height>
                <texture>$INFO[Container(100).ListItem.Property(icon)]</texture>
            </control>
            <control type="label">
                <posx>40</posx>
                <posy>2_row</posy>
                <width>23_col</width>
                <font>small</font>
                <label>$INFO[Container(100).ListItem.Property(summary)]</label>
            </control>
            <!--the selected day's hours, filled top to bottom in columns of 8-->
            <control type="panel" id="200">
                <posy>4_row</posy>
                <width>24_col</width>
                <height>8_row</height>
                <orientation>horizontal</orientation>
                <itemlayout width="8_col" height="1_row">
                    <include>weather_hour_row</include>
                </itemlayout>
                <focusedlayout width="8_col" height="1_row">
                    <include>weather_hour_row</include>
                </focusedlayout>
                <content>
                    <include content="weather_hour_item"><param name="n" value="1"/></include>
                    <include content="weather_hour_item"><param name="n" value="2"/></include>
                    <include content="weather_hour_item"><param name="n" value="3"/></include>
                    <include content="weather_hour_item"><param name="n" value="4"/></include>
                    <include content="weather_hour_item"><param name="n" value="5"/></include>
                    <include content="weather_hour_item"><param name="n" value="6"/></include>
                    <include content="weather_hour_item"><param name="n" value="7"/></include>
                    <include content="weather_hour_item"><param name="n" value="8"/></include>
                    <include content="weather_hour_item"><param name="n" value="9"/></include>
                    <include content="weather_hour_item"><param name="n" value="10"/></include>
                    <include content="weather_hour_item"><param name="n" value="11"/></include>
                    <include content="weather_hour_item"><param name="n" value="12"/></include>
                    <include content="weather_hour_item"><param name="n" value="13"/></include>
                    <include content="weather_hour_item"><param name="n" value="14"/></include>
                    <include content="weather_hour_item"><param name="n" value="15"/></include>
                    <include content="weather_hour_item"><param name="n" value="16"/></include>
                    <include content="weather_hour_item"><param name="n" value="17"/></include>
                    <include content="weather_hour_item"><param name="n" value="18"/></include>
                    <include content="weather_hour_item"><param name="n" value="19"/></include>
                    <include content="weather_hour_item"><param name="n" value="20"/></include>
                    <include content="weather_hour_item"><param name="n" value="21"/></include>
                    <include content="weather_hour_item"><param name="n" value="22"/></include>
                    <include content="weather_hour_item"><param name="n" value="23"/></include>
                    <include content="weather_hour_item"><param name="n" value="24"/></include>
                    <include content="weather_hour_item"><param name="n" value="25"/></include>
                    <include content="weather_hour_item"><param name="n" value="26"/></include>
                    <include content="weather_hour_item"><param name="n" value="27"/></include>
                    <include content="weather_hour_item"><param name="n" value="28"/></include>
                    <include content="weather_hour_item"><param name="n" value="29"/></include>
                    <include content="weather_hour_item"><param name="n" value="30"/></include>
                    <include content="weather_hour_item"><param name="n" value="31"/></include>
                    <include content="weather_hour_item"><param name="n" value="32"/></include>
                    <include content="weather_hour_item"><param name="n" value="33"/></include>
                    <include content="weather_hour_item"><param name="n" value="34"/></include>
                    <include content="weather_hour_item"><param name="n" value="35"/></include>
                    <include content="weather_hour_item"><param name="n" value="36"/></include>
                    <include content="weather_hour_item"><param name="n" value="37"/></include>
                    <include content="weather_hour_item"><param name="n" value="38"/></include>
                    <include content="weather_hour_item"><param name="n" value="39"/></include>
                    <include content="weather_hour_item"><param name="n" value="40"/></include>
                    <include content="weather_hour_item"><param name="n" value="41"/></include>
                    <include content="weather_hour_item"><param name="n" value="42"/></include>
                    <include content="weather_hour_item"><param name="n" value="43"/></include>
                    <include content="weather_hour_item"><param name="n" value="44"/></include>
                    <include content="weather_hour_item"><param name="n" value="45"/></include>
                    <include content="weather_hour_item"><param name="n" value="46"/></include>
                    <include content="weather_hour_item"><param name="n" value="47"/></include>
                    <include content="weather_hour_item"><param name="n" value="48"/></include>
                </content>
            </control>
        </control>
        <!--day selector: invisible list that keeps focus so up/down change the day-->
        <control type="list" id="100">
            <left>-100</left>
            <top>-100</top>
            <width>1</width>
            <height>10</height>
            <itemlayout height="1"/>
            <focusedlayout height="1"/>
            <content>
                <include content="weather_day_item"><param name="n" value="1"/><param name="title" value="$LOCALIZE[33006]"/></include>
                <include content="weather_day_item"><param name="n" value="2"/><param name="title" value="$LOCALIZE[33007]"/></include>
                <include content="weather_day_item"><param name="n" value="3"/><param name="title" value="$INFO[Weather.Data(Daily.3.LongDay)]"/></include>
                <include content="weather_day_item"><param name="n" value="4"/><param name="title" value="$INFO[Weather.Data(Daily.4.LongDay)]"/></include>
                <include content="weather_day_item"><param name="n" value="5"/><param name="title" value="$INFO[Weather.Data(Daily.5.LongDay)]"/></include>
                <include content="weather_day_item"><param name="n" value="6"/><param name="title" value="$INFO[Weather.Data(Daily.6.LongDay)]"/></include>
                <include content="weather_day_item"><param name="n" value="7"/><param name="title" value="$INFO[Weather.Data(Daily.7.LongDay)]"/></include>
                <include content="weather_day_item"><param name="n" value="8"/><param name="title" value="$INFO[Weather.Data(Daily.8.LongDay)]"/></include>
                <include content="weather_day_item"><param name="n" value="9"/><param name="title" value="$INFO[Weather.Data(Daily.9.LongDay)]"/></include>
                <include content="weather_day_item"><param name="n" value="10"/><param name="title" value="$INFO[Weather.Data(Daily.10.LongDay)]"/></include>
            </content>
        </control>
        <include content="debug_overlay"><param name="label" value="MyWeather.xml"/></include>
    </controls>
</window>
