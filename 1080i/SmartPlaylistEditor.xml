<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">22</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include content="page_background"><param name="image" value="music.png"/></include>
        <control type="group">
            <include>modal_dialog_in_out_vertical</include>
            <control type="group">
                <posx>col_7_begin</posx>
                <posy>row_3_begin</posy>
                <include content="dialog_title_bar"><param name="width" value="12_col"/><param name="label" value="31203"/></include>
                <!--name playlist-->
                <control type="group">
                    <posy>2_row</posy>
                    <control type="image">
                        <width>12_col</width>
                        <height>96</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="edit" id="12">
                        <description>Name Button</description>
                        <posx>12</posx>
                        <posy>12</posy>
                        <width>12_col_gutter</width>
                        <texturenofocus colordiffuse="99ffffff">colors/offblack.png</texturenofocus>
                        <texturefocus>colors/offblack.png</texturefocus>
                        <textoffsetx>24</textoffsetx>
                        <hinttext>31211</hinttext>
                        <align>left</align>
                        <onright>9002</onright>
                        <ondown>22</ondown>
                    </control>
                </control>
                <!--set playlist type, limits and sort-->
                <control type="group">
                    <posy>5_row</posy>
                    <control type="image">
                        <width>12_col</width>
                        <height>5_row</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="button" id="22">
                        <description>Set Playlist type</description>
                        <posx>12</posx>
                        <posy>12</posy>
                        <width>6_col_gutter</width>
                        <texturenofocus colordiffuse="overlay">colors/black.png</texturenofocus>
                        <label>467</label>
                        <onright>17</onright>
                        <ondown>18</ondown>
                        <onup>12</onup>
                    </control>
                    <control type="button" id="17">
                        <posx>6_col</posx>
                        <posy>12</posy>
                        <width>420</width>
                        <texturenofocus colordiffuse="overlay">colors/black.png</texturenofocus>
                        <label>21427</label>
                        <onleft>22</onleft>
                        <onup>12</onup>
                        <ondown>19</ondown>
                    </control>
                    <control type="button" id="18">
                        <posx>12</posx>
                        <posy>96</posy>
                        <width>6_col_gutter</width>
                        <label>21429</label>
                        <texturenofocus colordiffuse="overlay">colors/black.png</texturenofocus>
                        <onright>19</onright>
                        <onup>22</onup>
                        <ondown>10</ondown>
                    </control>
                    <control type="button" id="19">
                        <posx>6_col</posx>
                        <posy>96</posy>
                        <width>420</width>
                        <texturenofocus colordiffuse="overlay">colors/black.png</texturenofocus>
                        <label>580</label>
                        <onright>9002</onright>
                        <onup>17</onup>
                        <onleft>18</onleft>
                        <ondown>10</ondown>
                    </control>
                </control>
                <!--rules list-->
                <control type="group">
                    <posy>372</posy>
                    <control type="image">
                        <width>12_col</width>
                        <height>8_row</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="panel" id="10">
                        <description>Rules List Control</description>
                        <posx>1_col_indent</posx>
                        <posy>12</posy>
                        <width>11_col_gutter</width>
                        <height>4_row</height>
                        <onup>18</onup>
                        <onleft>9001</onleft>
                        <ondown>16</ondown>
                        <itemlayout width="12_col" height="2_row">
                            <control type="image">
                                <width>12_col</width>
                                <height>69</height>
                                <texture>colors/black.png</texture>
                                <colordiffuse>overlay</colordiffuse>
                            </control>
                            <control type="label">
                                <posx>12</posx>
                                <width>12_col_gutter</width>
                                <height>2_row</height>
                                <font>item_title</font>
                                <selectedcolor>black</selectedcolor>
                                <info>ListItem.Label</info>
                            </control>
                        </itemlayout>
                        <focusedlayout width="12_col" height="2_row">
                            <control type="image">
                                <width>12_col</width>
                                <height>69</height>
                                <texture>colors/white.png</texture>
                            </control>
                            <control type="label">
                                <posx>12</posx>
                                <width>12_col_gutter</width>
                                <height>2_row</height>
                                <font>item_title</font>
                                <textcolor>black</textcolor>
                                <selectedcolor>black</selectedcolor>
                                <info>ListItem.Label</info>
                            </control>
                        </focusedlayout>
                    </control>
                    <!--items must match...-->
                    <control type="image">
                        <posy>300</posy>
                        <width>12_col</width>
                        <height>96</height>
                        <texture>colors/black.png</texture>
                        <colordiffuse>overlay</colordiffuse>
                    </control>
                    <control type="button" id="16">
                        <posx>12</posx>
                        <posy>312</posy>
                        <width>12_col_gutter</width>
                        <label>21424</label>
                        <onright>9002</onright>
                        <onup>10</onup>
                        <ondown>9002</ondown>
                    </control>
                </control>
                <!--add / edit / delete rules-->
                <control type="panel" id="9001">
                    <posx>12</posx>
                    <posy>382</posy>
                    <width>12_col_gutter</width>
                    <height>8_row</height>
                    <onright>10</onright>
                    <onup>18</onup>
                    <orientation>horizontal</orientation>
                    <include content="layout_symbol_button"><param name="width" value="3_col"/><param name="bg_color" value="overlay"/><param name="focus_width" value="1_col_textbox"/></include>
                    <content>
                        <item id="1">
                            <description>New Rule</description>
                            <label>15019</label>
                            <label2></label2>
                            <onclick>SendClick(129,13)</onclick>
                        </item>
                    </content>
                </control>
                <!--OK / Cancel-->
                <control type="panel" id="9002">
                    <posy>780</posy>
                    <width>8_col</width>
                    <height>2_row</height>
                    <orientation>horizontal</orientation>
                    <onup>16</onup>
                    <itemlayout width="4_col" height="2_row">
                        <control type="image">
                            <width>276</width>
                            <height>2_row</height>
                            <texture>colors/black.png</texture>
                            <colordiffuse>overlay</colordiffuse>
                        </control>
                        <control type="label">
                            <width>1_col</width>
                            <height>2_row</height>
                            <align>center</align>
                            <font>symbol_large</font>
                            <label>$INFO[ListItem.label2]</label>
                        </control>
                        <control type="label">
                            <posx>1_col_indent</posx>
                            <posy>-1</posy>
                            <width>5_col_gutter</width>
                            <height>2_row</height>
                            <font>button_title</font>
                            <label>$INFO[ListItem.label]</label>
                        </control>
                    </itemlayout>
                    <focusedlayout width="4_col" height="2_row">
                        <control type="image">
                            <width>1_col</width>
                            <height>2_row</height>
                            <texture>colors/white.png</texture>
                            <colordiffuse>highlight</colordiffuse>
                            <include>spin_focus_icon</include>
                        </control>
                        <control type="image">
                            <posx>1_col</posx>
                            <width>204</width>
                            <height>2_row</height>
                            <texture>colors/white.png</texture>
                        </control>
                        <control type="label">
                            <width>1_col</width>
                            <height>2_row</height>
                            <align>center</align>
                            <font>symbol_large</font>
                            <label>$INFO[ListItem.label2]</label>
                        </control>
                        <control type="label">
                            <posx>1_col_indent</posx>
                            <posy>-1</posy>
                            <width>5_col_gutter</width>
                            <height>2_row</height>
                            <font>button_title</font>
                            <textcolor>black</textcolor>
                            <label>$INFO[ListItem.label]</label>
                        </control>
                    </focusedlayout>
                    <content>
                        <item id="1">
                            <description>Ok Button</description>
                            <label>186</label>
                            <label2></label2>
                            <onclick>SendClick(129,20)</onclick>
                        </item>
                        <item id="2">
                            <description>Cancel Button</description>
                            <label>222</label>
                            <label2></label2>
                            <onclick>SendClick(129,21)</onclick>
                        </item>
                    </content>
                </control>
            </control>
            <!--buttons-->
            <control type="group">
                <visible>false</visible>
                <control type="button" id="13">
                    <description>Add Rule Button</description>
                </control>
                <control type="button" id="14">
                    <description>Remove Rule Button</description>
                </control>
                <control type="button" id="15">
                    <description>Edit Rule Button</description>
                </control>
                <control type="button" id="20">
                    <description>Ok Button</description>
                    <label>186</label>
                </control>
                <control type="button" id="21">
                    <description>Cancel Button</description>
                    <label>222</label>
                </control>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="SmartPlaylistEditor.xml"/></include>
    </controls>
</window>
