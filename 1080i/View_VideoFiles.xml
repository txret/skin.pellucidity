<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!--Plain rows (view 55) for video sources, files and add-on folders, with a tick on watched
        items. Inside a plugin the focused item's fanart becomes the page background.-->
    <include name="view_video_files">
        <!--fanart-->
        <control type="group">
            <include content="page_background"><param name="image" value="video.jpg"/></include>
            <visible>String.Contains(Container.folderpath,plugin) + !$EXP[is_addon_movie_or_tvshow] + !$EXP[is_plugin_show]</visible>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <texture>$VAR[list_fanart]</texture>
                <fadetime>500</fadetime>
                <colordiffuse>FF555555</colordiffuse>
            </control>
        </control>
        <control type="panel" id="55">
            <include content="page_background"><param name="image" value="video.jpg"/></include>
            <visible>$EXP[is_video_list]</visible>
            <posx>col_1_begin</posx>
            <posy>row_5_begin</posy>
            <width>24_col</width>
            <height>23_row</height>
            <onleft>9000</onleft>
            <onright>SetFocus(60,$VAR[jump_index],absolute)</onright>
            <ondown>55</ondown>
            <onup>55</onup>
            <include content="layout_file_row">
                <param name="label_width" value="22_col_gutter"/>
                <param name="thumb" value="$VAR[list_thumb]"/>
                <param name="thumb_aspect" value="scale"/>
                <!--watched mark at the right end of the row-->
                <control type="label">
                    <visible>!String.IsEmpty(ListItem.playcount)</visible>
                    <posx>23_col_gutter</posx>
                    <width>1_col</width>
                    <height>2_row</height>
                    <align>right</align>
                    <font>symbol_large</font>
                    <label></label>
                </control>
            </include>
        </control>
    </include>
</includes>
