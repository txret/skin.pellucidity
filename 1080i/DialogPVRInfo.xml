<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">8000</defaultcontrol>
    <controls>
        <!--background-->
        <control type="group">
            <include>fade_in_out</include>
            <control type="image">
                <include>dimensions_fullscreen</include>
                <texture>colors/black.png</texture>
                <colordiffuse>eeFFFFFF</colordiffuse>
            </control>
        </control>
        <!--content-->
        <control type="group">
            <posx>col_7_begin</posx>
            <posy>row_5_begin</posy>
            <include>modal_dialog_in_out</include>
            <!--titles-->
            <control type="label">
                <description>Episode title</description>
                <width>12_col_gutter</width>
                <height>3_row</height>
                <font>large_title</font>
                <label>$INFO[ListItem.Label]</label>
                <wrapmultiline>true</wrapmultiline>
            </control>
            <!--meta-->
            <control type="panel">
                <posy>132</posy>
                <width>10_col</width>
                <height>6_row</height>
                <enable>false</enable>
                <itemlayout width="5_col" height="78">
                    <control type="label">
                        <width>324</width>
                        <font>item_subtitle</font>
                        <textcolor>highlight</textcolor>
                        <label>[B]$INFO[ListItem.label][/B]</label>
                    </control>
                    <control type="label">
                        <posy>30</posy>
                        <width>324</width>
                        <font>item_subtitle</font>
                        <label fallback="13205">[B]$INFO[ListItem.label2][/B]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="5_col" height="78">
                </focusedlayout>
                <content>
                    <item>
                        <label>$LOCALIZE[19029]</label>
                        <label2>$INFO[ListItem.channelname]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[552]</label>
                        <label2>$INFO[ListItem.startdate]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[515]</label>
                        <label2>$INFO[ListItem.genre]</label2>
                    </item>
                    <item>
                        <label>$LOCALIZE[180]</label>
                        <label2>$INFO[ListItem.duration]</label2>
                    </item>
                </content>
            </control>
            <!--synopsis-->
            <control type="textbox">
                <posy>292</posy>
                <font>textbox</font>
                <width>12_col</width>
                <align>left</align>
                <height>232</height>
                <label>$INFO[ListItem.plot]</label>
                <autoscroll>false</autoscroll>
                <pagecontrol>61</pagecontrol>
            </control>
            <control type="scrollbar" id="61">
                <posx>-36</posx>
                <posy>300</posy>
                <height>6_row</height>
                <ondown>8000</ondown>
            </control>
            <!--dialog controls-->
            <control type="list" id="8000">
                <posy>16_row</posy>
                <width>12_col</width>
                <height>2_row</height>
                <onup>61</onup>
                <orientation>horizontal</orientation>
                <include content="layout_info_button_list"><param name="width" value="4_col"/><param name="label_width" value="3_col"/><param name="focus_width" value="3_col"/></include>
                <content>
                    <item id="1">
                        <visible>window.isactive(tvchannels) | window.isactive(radiochannels) | window.isactive(tvguide)</visible>
                        <label>208</label>
                        <label2></label2>
                        <onclick>sendclick(pvrguideinfo,5)</onclick>
                    </item>
                    <item id="2">
                        <visible>window.isactive(tvrecordings) | window.isactive(radiorecordings)</visible>
                        <label>208</label>
                        <label2></label2>
                        <onclick>sendclick(pvrrecordinginfo,8)</onclick>
                    </item>
                    <item id="3">
                        <visible>!window.isactive(tvrecordings) + !window.isactive(radiorecordings)</visible>
                        <label>264</label>
                        <label2></label2>
                        <onclick>SendClick(pvrguideinfo,6)</onclick>
                    </item>
                    <item id="4">
                        <visible>window.isactive(tvchannels) | window.isactive(radiochannels) | window.isactive(tvguide)</visible>
                        <label>826</label>
                        <label2></label2>
                        <onclick>SendClick(pvrguideinfo,11)</onclick>
                    </item>
                    <item id="5">
                        <visible>!window.isactive(tvrecordings) + !window.isactive(radiorecordings) + !window.isactive(tvguide)</visible>
                        <label>31073</label>
                        <label2></label2>
                        <onclick>dialog.close(all,true)</onclick>
                        <onclick>ActivateWindow(TVGuide)</onclick>
                        <onclick>Control.SetFocus(10)</onclick>
                    </item>
                </content>
            </control>
        </control>
        <!--buttons-->
        <control type="group">
            <visible>false</visible>
            <control type="button" id="4">
                <description>Find similar</description>
                <label>19003</label>
            </control>
            <control type="button" id="5">
                <description>Switch to Channel</description>
                <label>19165</label>
            </control>
            <control type="button" id="6">
                <description>Record</description>
            </control>
            <control type="button" id="8">
                <description>Play recording</description>
                <label>19687</label>
            </control>
            <control type="button" id="11">
                <description>Set Reminder</description>
                <label>826</label>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogPVRInfo.xml"/></include>
    </controls>
</window>
