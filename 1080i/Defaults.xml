<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <default type="label">
        <height>1_row</height>
        <aligny>center</aligny>
        <font>regular</font>
        <textcolor>text_active</textcolor>
        <focusedcolor>text_active</focusedcolor>
        <selectedcolor>text_active</selectedcolor>
        <disabledcolor>text_disabled</disabledcolor>
    </default>
    <default type="textbox">
        <font>regular</font>
        <textcolor>text_active</textcolor>
    </default>
    <default type="fadelabel">
        <height>57</height>
        <aligny>center</aligny>
        <font>regular</font>
        <textcolor>text_active</textcolor>
        <focusedcolor>text_active</focusedcolor>
        <selectedcolor>text_active</selectedcolor>
        <disabledcolor>text_disabled</disabledcolor>
        <scrollout>false</scrollout>
        <pauseatend>2000</pauseatend>
    </default>
    <default type="button">
        <aligny>center</aligny>
        <height>2_row</height>
        <width>4_col</width>
        <font>button_title</font>
        <textcolor>text_active</textcolor>
        <focusedcolor>black</focusedcolor>
        <texturefocus>colors/white.png</texturefocus>
        <textoffsetx>24</textoffsetx>
        <disabledcolor>text_disabled</disabledcolor>
        <invalidcolor>text_disabled</invalidcolor>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="togglebutton">
        <width>2_col</width>
        <height>2_row</height>
        <aligny>center</aligny>
        <textoffsetx>24</textoffsetx>
        <texturefocus>colors/white.png</texturefocus>
        <alttexturefocus>colors/white.png</alttexturefocus>
        <font>button_title</font>
        <textcolor>text_active</textcolor>
        <focusedcolor>black</focusedcolor>
        <disabledcolor>text_disabled</disabledcolor>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="radiobutton">
        <height>2_row</height>
        <aligny>center</aligny>
        <textoffsetx>24</textoffsetx>
        <font>button_title</font>
        <textcolor>text_active</textcolor>
        <focusedcolor>black</focusedcolor>
        <disabledcolor>text_disabled</disabledcolor>
        <texturefocus>colors/white.png</texturefocus>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="spincontrolex">
        <height>2_row</height>
        <aligny>center</aligny>
        <textoffsetx>24</textoffsetx>
        <font>button_title</font>
        <textcolor>text_active</textcolor>
        <focusedcolor>black</focusedcolor>
        <disabledcolor>text_disabled</disabledcolor>
        <spinwidth>30</spinwidth>
        <spinheight>30</spinheight>
        <texturefocus>colors/white.png</texturefocus>
        <textureup>UIControls/arrow-up-nf.png</textureup>
        <texturedown>UIControls/arrow-down-nf.png</texturedown>
        <textureupfocus>UIControls/arrow-up-fo.png</textureupfocus>
        <texturedownfocus>UIControls/arrow-down-fo.png</texturedownfocus>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="spincontrol">
        <height>2_row</height>
        <aligny>center</aligny>
        <textoffsetx>24</textoffsetx>
        <font>button_title</font>
        <textcolor>text_active</textcolor>
        <focusedcolor>black</focusedcolor>
        <disabledcolor>text_disabled</disabledcolor>
        <spinwidth>36</spinwidth>
        <spinheight>36</spinheight>
        <texturefocus>colors/white.png</texturefocus>
        <textureup>UIControls/arrow-up-nf.png</textureup>
        <texturedown>UIControls/arrow-down-nf.png</texturedown>
        <textureupfocus>UIControls/arrow-up-fo.png</textureupfocus>
        <texturedownfocus>UIControls/arrow-down-fo.png</texturedownfocus>
        <pulseonselect>false</pulseonselect>
    </default>
    <!--used in audio settings etc-->
    <default type="sliderex">
        <height>2_row</height>
        <aligny>center</aligny>
        <font>button_title</font>
        <textoffsetx>24</textoffsetx>
        <textcolor>text_active</textcolor>
        <focusedcolor>black</focusedcolor>
        <disabledcolor>text_disabled</disabledcolor>
        <texturefocus>colors/white.png</texturefocus>
        <sliderwidth>0</sliderwidth>
        <sliderheight>0</sliderheight>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="progress">
        <height>12</height>
        <midtexture border="10">colors/white.png</midtexture>
    </default>
    <default type="scrollbar">
        <width>12</width>
        <texturesliderbackground colordiffuse="overlay">colors/black.png</texturesliderbackground>
        <texturesliderbarfocus colordiffuse="highlight">colors/white.png</texturesliderbarfocus>
        <showonepage>false</showonepage>
    </default>
    <default type="edit">
        <width>8_col</width>
        <height>2_row</height>
        <font>medium_strong</font>
        <textcolor>text_active</textcolor>
        <disabledcolor>text_active</disabledcolor>
        <invalidcolor>text_active</invalidcolor>
        <focusedcolor>text_active</focusedcolor>
        <textoffsetx>12</textoffsetx>
        <align>center</align>
        <aligny>center</aligny>
        <texturefocus colordiffuse="textbox_inactive">colors/black.png</texturefocus>
        <texturenofocus colordiffuse="overlay">colors/black.png</texturenofocus>
        <pulseonselect>false</pulseonselect>
    </default>
</includes>
