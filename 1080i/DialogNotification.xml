<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <control type="group">
            <posx>col_19_begin</posx>
            <posy>row_2_begin</posy>
            <animation type="Windowclose">
                <effect type="fade" start="100" end="0" time="400" tween="sine"/>
            </animation>
            <control type="group">
                <animation type="Windowopen">
                    <effect type="slide" start="1000,0" end="0,0" time="400" tween="sine"/>
                </animation>
                <include>toast_card</include>
                <control type="label" id="401">
                    <description>heading</description>
                    <visible>!String.IsEqual(control.getlabel(401),control.getlabel(402))</visible>
                    <include>toast_heading</include>
                    <animation type="Windowopen">
                        <effect type="fade" start="0" end="100" delay="400" time="400" tween="sine"/>
                    </animation>
                </control>
                <control type="label">
                    <visible>String.IsEqual(control.getlabel(401),control.getlabel(402))</visible>
                    <include>toast_heading</include>
                    <label>31023</label>
                    <animation type="Windowopen">
                        <effect type="fade" start="0" end="100" delay="400" time="400" tween="sine"/>
                    </animation>
                </control>
                <control type="label" id="402">
                    <description>message</description>
                    <include>toast_message</include>
                    <scroll>true</scroll>
                    <scrollspeed>100</scrollspeed>
                    <animation type="Windowopen">
                        <effect type="fade" start="0" end="100" delay="600" time="400" tween="sine"/>
                    </animation>
                </control>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogNotification.xml"/></include>
    </controls>
</window>
