<?xml version="1.0" encoding="utf-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <!-- options menu-->
        <!--overlay-->
        <control type="image">
            <include>dimensions_fullscreen</include>
            <texture>colors/black.png</texture>
            <colordiffuse>e9FFFFFF</colordiffuse>
        </control>
        <control type="group">
            <include>modal_dialog_in_out_vertical</include>
            <posx>col_10_begin</posx>
            <posy>row_7_begin</posy>
            <!--controls-->
            <control type="panel" id="100">
                <posy>4_row</posy>
                <width>6_col</width>
                <height>14_row</height>
                <include content="layout_osd_button"><param name="width" value="6_col"/><param name="label_width" value="5_col_gutter"/><param name="font" value="button_title"/><param name="focus_width" value="6_col"/></include>
                <content>
                    <item>
                        <visible>Player.Playing | player.forwarding | player.rewinding</visible>
                        <description>Play/Pause</description>
                        <label>$LOCALIZE[35224]</label>
                        <label2></label2>
                        <onclick>PlayerControl(play)</onclick>
                    </item>
                    <item>
                        <visible>Player.Paused</visible>
                        <description>Pause</description>
                        <label>$LOCALIZE[35224]</label>
                        <label2></label2>
                        <onclick>PlayerControl(play)</onclick>
                    </item>
                    <item>
                        <description>Reset button</description>
                        <label>$LOCALIZE[13007]</label>
                        <label2></label2>
                        <onclick>PlayerControl(Reset)</onclick>
                    </item>
                    <item>
                        <description>Stop button</description>
                        <label>$LOCALIZE[35222]</label>
                        <label2></label2>
                        <onclick>PlayerControl(Stop)</onclick>
                    </item>
                    <item>
                        <description>Settings button</description>
                        <label>$LOCALIZE[5]</label>
                        <label2></label2>
                        <onclick>ActivateWindow(1101)</onclick>
                    </item>
                </content>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="GameOSD.xml"/></include>
    </controls>
</window>
