<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9000</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include>modal_dialog_dim</include>
        <control type="group">
            <posx>col_9_begin</posx>
            <posy>row_8_begin</posy>
            <include>modal_dialog_in_out</include>
            <!--progress-->
            <control type="label">
                <posy>-72</posy>
                <width>8_col_gutter</width>
                <height>2_row</height>
                <wrapmultiline>true</wrapmultiline>
                <font>medium_strong</font>
                <label>$INFO[System.Progressbar,,%]</label>
            </control>
            <!--text-->
            <control type="label" id="1">
                <description>heading</description>
                <width>8_col_gutter</width>
                <height>2_row</height>
                <wrapmultiline>true</wrapmultiline>
                <font>confirm_title</font>
            </control>
            <control type="textbox" id="9">
                <posy>80</posy>
                <width>8_col_gutter</width>
                <height>124</height>
                <font>textbox</font>
                <autoscroll delay="3000" time="2000" repeat="5000"/>
            </control>
            <!--options-->
            <control type="panel" id="9000">
                <posy>228</posy>
                <width>8_col</width>
                <height>6_row</height>
                <itemlayout width="8_col" height="2_row">
                    <control type="label">
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label>$INFO[ListItem.label2]</label>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <posy>-1</posy>
                        <width>7_col_gutter</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="8_col" height="2_row">
                    <control type="image">
                        <width>1_col_textbox</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                        <colordiffuse>highlight</colordiffuse>
                        <include>spin_focus_icon</include>
                        <animation type="conditional" condition="true">
                            <effect type="fade" start="100" end="50" time="0"/>
                        </animation>
                    </control>
                    <control type="image">
                        <posx>1_col</posx>
                        <width>7_col</width>
                        <height>2_row</height>
                        <texture>colors/white.png</texture>
                    </control>
                    <control type="label">
                        <width>1_col</width>
                        <height>2_row</height>
                        <align>center</align>
                        <font>symbol_large</font>
                        <label>$INFO[ListItem.label2]</label>
                    </control>
                    <control type="label">
                        <posx>1_col_indent</posx>
                        <posy>-1</posy>
                        <width>7_col_gutter</width>
                        <height>2_row</height>
                        <font>button_title</font>
                        <textcolor>black</textcolor>
                        <label>$INFO[ListItem.label]</label>
                    </control>
                </focusedlayout>
                <content>
                    <item id="1">
                        <visible>control.isvisible(10)</visible>
                        <description>No</description>
                        <label>$INFO[control.getlabel(10)]</label>
                        <label2></label2>
                        <onclick>SendClick(10)</onclick>
                    </item>
                    <item id="2">
                        <visible>control.isvisible(11)</visible>
                        <description>Yes / OK</description>
                        <label>$INFO[control.getlabel(11)]</label>
                        <label2></label2>
                        <onclick>SendClick(11)</onclick>
                    </item>
                    <item id="3">
                        <visible>control.isvisible(12)</visible>
                        <description>Custom Button</description>
                        <label>$INFO[control.getlabel(12)]</label>
                        <label2></label2>
                        <onclick>SendClick(12)</onclick>
                    </item>
                </content>
            </control>
            <!--buttons (hidden from view)-->
            <control type="group">
                <visible>false</visible>
                <!--selection buttons-->
                <control type="button" id="10">
                    <description>No</description>
                </control>
                <control type="button" id="11">
                    <description>Yes</description>
                </control>
                <control type="button" id="12">
                    <description>Custom</description>
                </control>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogConfirm.xml"/></include>
    </controls>
</window>
