<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="false">9999</defaultcontrol>
    <onload condition="Skin.hassetting(stopVideoOnMenu) + !Player.HasAudio">PlayerControl(stop)</onload>
    <include>fade_in_out</include>
    <views>50</views>
    <controls>
        <include content="page_background"><param name="image" value="tv.jpg"/></include>
        <!--page container group-->
        <control type="group">
            <!--window fader-->
            <animation type="conditional" condition="window.next(0) | window.next(1)">
                <effect type="fade" start="100" end="0" time="300"/>
            </animation>
            <include>modal_dialog_content_shift</include>
            <!--Main content listing-->
            <control type="group" id="9999">
                <include>content_open</include>
                <posx>col_1_begin</posx>
                <posy>row_5_begin</posy>
                <control type="panel" id="50">
                    <width>24_col</width>
                    <height>23_row</height>
                    <onleft>9000</onleft>
                    <onright>60</onright>
                    <pagecontrol>60</pagecontrol>
                    <itemlayout width="24_col" height="2_row">
                        <control type="image">
                            <posx>1_col</posx>
                            <width>23_col</width>
                            <height>69</height>
                            <texture>colors/black.png</texture>
                            <colordiffuse>overlay</colordiffuse>
                        </control>
                        <control type="image">
                            <posy>3</posy>
                            <width>66</width>
                            <height>66</height>
                            <aspectratio scalediffuse="false">stretch</aspectratio>
                            <texture fallback="colors/black.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                            <colordiffuse>overlay</colordiffuse>
                        </control>
                        <control type="label">
                            <visible>!String.IsEmpty(ListItem.playcount) + !ListItem.IsResumable</visible>
                            <posx>16</posx>
                            <posy>2</posy>
                            <width>66</width>
                            <height>66</height>
                            <font>symbol_large</font>
                            <label>✓</label>
                        </control>
                        <control type="label">
                            <posx>1_col_indent</posx>
                            <width>15_col</width>
                            <height>2_row</height>
                            <font>item_title</font>
                            <label>$INFO[ListItem.Label]$INFO[ListItem.EpisodeName,  - ,]</label>
                        </control>
                        <control type="label">
                            <right>12</right>
                            <width>12_col</width>
                            <height>2_row</height>
                            <align>right</align>
                            <font>item_title</font>
                            <label>$INFO[ListItem.Date,,   ]$INFO[ListItem.Duration,(,)]</label>
                        </control>
                    </itemlayout>
                    <focusedlayout width="24_col" height="2_row">
                        <control type="image">
                            <posx>1_col</posx>
                            <width>23_col</width>
                            <height>2_row</height>
                            <texture>colors/white.png</texture>
                            <colordiffuse>highlight</colordiffuse>
                        </control>
                        <control type="group">
                            <include>spin_focus_thumb</include>
                            <control type="image">
                                <posy>3</posy>
                                <width>66</width>
                                <height>66</height>
                                <aspectratio scalediffuse="false">stretch</aspectratio>
                                <texture fallback="colors/white.png" diffuse="masks/circle.png">$INFO[Listitem.thumb]</texture>
                            </control>
                            <control type="label">
                                <visible>!String.IsEmpty(ListItem.playcount) + !ListItem.IsResumable</visible>
                                <posx>16</posx>
                                <posy>2</posy>
                                <width>66</width>
                                <height>66</height>
                                <font>symbol_large</font>
                                <textcolor>black</textcolor>
                                <label>✓</label>
                            </control>
                        </control>
                        <control type="label">
                            <posx>1_col_indent</posx>
                            <width>15_col</width>
                            <height>2_row</height>
                            <font>item_title</font>
                            <label>$INFO[ListItem.Label]$INFO[ListItem.EpisodeName,  - ,]</label>
                        </control>
                        <control type="label">
                            <right>12</right>
                            <width>12_col</width>
                            <height>2_row</height>
                            <align>right</align>
                            <font>item_title</font>
                            <label>$INFO[ListItem.Date,,   ]$INFO[ListItem.Duration,(,)]</label>
                        </control>
                    </focusedlayout>
                </control>
            </control>
            <include>page_scrollbar</include>
            <include>page_header</include>
        </control>
        <include>mini_video_player</include>
        <include>hub_menu</include>
        <include content="debug_overlay"><param name="label" value="MyPVRRecordings.xml path: $INFO[container.folderpath] folder: $INFO[container.foldername] content: $INFO[container.content]"/></include>
    </controls>
</window>
