<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">59</defaultcontrol>
    <onload condition="Skin.hassetting(stopVideoOnMenu) + !Player.HasAudio">PlayerControl(stop)</onload>
    <include>fade_in_out</include>
    <views>59</views>
    <controls>
        <include content="page_background"><param name="image" value="music.png"/></include>
        <!--fanart-->
        <control type="image">
            <include>dimensions_fullscreen</include>
            <aspectratio scalediffuse="false">stretch</aspectratio>
            <texture background="true">$INFO[Listitem.art(fanart)]</texture>
            <fadetime>500</fadetime>
            <colordiffuse>22ffffff</colordiffuse>
        </control>
        <control type="image">
            <texture>vignette.png</texture>
        </control>
        <!--page container group-->
        <control type="group">
            <include>modal_dialog_content_shift</include>
            <!--Main content listing-->
            <control type="group" id="9999">
                <include>content_open</include>
                <include>view_music_playlist</include>
            </control>
            <include>page_scrollbar</include>
            <include>page_header</include>
        </control>
        <include>mini_video_player</include>
        <include>hub_menu</include>
        <include content="debug_overlay"><param name="label" value="MyPlaylist.xml path: $INFO[container.folderpath]   name: $INFO[container.foldername]   content: $INFO[container.content]    Control: $INFO[System.CurrentControl]"/></include>
    </controls>
</window>
