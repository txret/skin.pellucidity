<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <include>fade_in_out</include>
    <views>50</views>
    <controls>
        <include content="page_background"><param name="image" value="music.png"/></include>
        <control type="group">
            <include>modal_dialog_in_out_vertical</include>
            <!--page title-->
            <control type="group">
                <posx>col_2_begin</posx>
                <posy>row_4_begin</posy>
                <include content="dialog_title_bar"><param name="width" value="22_col"/><param name="label" value="31057"/></include>
                <control type="image">
                    <posy>2_row</posy>
                    <width>22_col</width>
                    <height>19_row</height>
                    <texture>colors/black.png</texture>
                    <colordiffuse>overlay</colordiffuse>
                </control>
                <control type="image">
                    <posx>18_col</posx>
                    <posy>2_row</posy>
                    <width>4_col</width>
                    <height>19_row</height>
                    <texture>colors/black.png</texture>
                    <colordiffuse>overlay</colordiffuse>
                </control>
            </control>
            <!--left panel-->
            <control type="group">
                <posx>col_2_begin</posx>
                <posy>row_6_begin</posy>
                <control type="image">
                    <width>9_col</width>
                    <height>71</height>
                    <texture>colors/white.png</texture>
                </control>
                <control type="label">
                    <description>Header Label</description>
                    <posx>24</posx>
                    <height>2_row</height>
                    <width>8_col_gutter</width>
                    <label>31022</label>
                    <font>settings_category_title</font>
                    <textcolor>black</textcolor>
                </control>
                <!--left file list-->
                <control type="list" id="50">
                    <posy>2_row</posy>
                    <width>9_col</width>
                    <height>17_row</height>
                    <onright>100</onright>
                    <include content="layout_playlist_editor_row"><param name="width" value="9_col"/><param name="focus_condition" value="!Control.HasFocus(50)"/></include>
                </control>
            </control>
            <!--right panel-->
            <control type="group">
                <posx>col_11_begin</posx>
                <posy>row_6_begin</posy>
                <control type="image">
                    <width>13_col</width>
                    <height>71</height>
                    <texture>colors/white.png</texture>
                </control>
                <control type="label">
                    <description>Header Label</description>
                    <posx>12</posx>
                    <width>9_col_gutter</width>
                    <height>2_row</height>
                    <label>13350</label>
                    <font>settings_category_title</font>
                    <textcolor>black</textcolor>
                </control>
                <control type="list" id="100">
                    <posy>2_row</posy>
                    <width>9_col</width>
                    <height>15_row</height>
                    <onleft>50</onleft>
                    <onright>9000</onright>
                    <include content="layout_playlist_editor_row"><param name="width" value="636"/><param name="focus_condition" value="!Control.HasFocus(100)"/></include>
                </control>
                <!--dialog controls-->
                <control type="group">
                    <posx>9_col</posx>
                    <control type="panel" id="9000">
                        <posy>2_row</posy>
                        <width>4_col</width>
                        <height>6_row</height>
                        <onleft>100</onleft>
                        <include content="layout_icon_button_sized"><param name="height" value="2_row"/><param name="width" value="6_col"/><param name="label_width" value="3_col_gutter"/><param name="focus_width" value="3_col"/></include>
                        <content>
                            <item id="1">
                                <description>Open</description>
                                <label>31019</label>
                                <label2></label2>
                                <onclick>SendClick(503,6)</onclick>
                            </item>
                            <item id="2">
                                <description>Save</description>
                                <label>31020</label>
                                <label2></label2>
                                <onclick>SendClick(503,7)</onclick>
                                <onclick>Notification($LOCALIZE[31020],$LOCALIZE[31153])</onclick>
                            </item>
                            <item id="3">
                                <description>Clear</description>
                                <label>31021</label>
                                <label2></label2>
                                <onclick>SendClick(503,8)</onclick>
                            </item>
                        </content>
                    </control>
                </control>
            </control>
        </control>
        <!--buttons-->
        <control type="group">
            <visible>false</visible>
            <control type="button" id="6">
                <description>Open Button</description>
            </control>
            <control type="button" id="7">
                <description>Save Button</description>
            </control>
            <control type="button" id="8">
                <description>Clear button</description>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="MyMusicPlaylistEditor.xml"/></include>
    </controls>
</window>
