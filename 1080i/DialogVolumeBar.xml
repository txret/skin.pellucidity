<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <control type="group">
            <include>toast_position</include>
            <visible>!player.passthrough</visible>
            <animation type="Windowclose">
                <effect type="fade" start="100" end="0" time="400" tween="sine"/>
            </animation>
            <include>toast_card</include>
            <control type="label">
                <description>heading</description>
                <include>toast_heading</include>
                <label>13376</label>
            </control>
            <control type="label">
                <visible>Player.Muted</visible>
                <posx>2_col</posx>
                <posy>35</posy>
                <width>1_col</width>
                <height>1_col</height>
                <align>center</align>
                <font>symbol_large</font>
                <textcolor>black</textcolor>
                <label></label>
            </control>
            <control type="label">
                <description>message</description>
                <include>toast_message</include>
                <label>$INFO[Control.GetLabel(20),, %]</label>
            </control>
        </control>
        <!--hidden progress control: the only way to read the volume as a percentage-->
        <control type="progress" id="20">
            <visible>false</visible>
            <info>Player.Volume</info>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogVolumeBar.xml"/></include>
    </controls>
</window>
