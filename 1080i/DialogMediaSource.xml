<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol>8000</defaultcontrol>
    <include>fade_in_out</include>
    <controls>
        <include content="page_background"><param name="image" value="settings.jpg"/></include>
        <include>mini_video_player</include>
        <control type="group" id="9001">
            <posx>col_7_begin</posx>
            <posy>row_7_begin</posy>
            <include>modal_dialog_in_out_vertical</include>
            <include content="dialog_title_bar"><param name="width" value="12_col"/><param name="label" value="$LOCALIZE[1026]"/></include>
            <!--dialog controls 1-->
            <control type="group">
                <posy>96</posy>
                <control type="image">
                    <posy>-12</posy>
                    <width>12_col</width>
                    <height>96</height>
                    <texture>colors/black.png</texture>
                    <colordiffuse>overlay</colordiffuse>
                </control>
                <control type="panel" id="8000">
                    <posx>780</posx>
                    <width>1_col</width>
                    <height>6_row</height>
                    <onleft>10</onleft>
                    <ondown>12</ondown>
                    <include content="layout_symbol_button"><param name="width" value="1_col"/><param name="bg_color" value="textbox_inactive"/><param name="focus_width" value="1_col"/></include>
                    <content>
                        <item>
                            <description>Browse</description>
                            <label>1024</label>
                            <label2></label2>
                            <onclick>SendClick(129,11)</onclick>
                        </item>
                    </content>
                </control>
            </control>

            <control type="group">
                <posy>96</posy>
                <!--path list-->
                <control type="panel" id="10">
                    <posx>12</posx>
                    <width>11_col_gutter</width>
                    <height>6_row</height>
                    <onright>8000</onright>
                    <ondown>12</ondown>
                    <scrolltime>200</scrolltime>
                    <itemlayout width="11_col_gutter" height="2_row">
                        <control type="image">
                            <width>11_col_gutter</width>
                            <height>2_row</height>
                            <texture>colors/black.png</texture>
                            <colordiffuse>textbox_inactive</colordiffuse>
                        </control>
                        <control type="label">
                            <posx>12</posx>
                            <width>11_col_gutter</width>
                            <height>2_row</height>
                            <font>item_title</font>
                            <label>$LOCALIZE[573]: $INFO[listitem.label]</label>
                        </control>
                    </itemlayout>
                    <focusedlayout width="11_col_gutter" height="2_row">
                        <control type="image">
                            <width>11_col_gutter</width>
                            <height>2_row</height>
                            <texture>colors/white.png</texture>
                        </control>
                        <control type="label">
                            <posx>12</posx>
                            <width>11_col_gutter</width>
                            <height>2_row</height>
                            <font>item_title</font>
                            <textcolor>black</textcolor>
                            <selectedcolor>black</selectedcolor>
                            <label>$LOCALIZE[573]: $INFO[listitem.label]</label>
                        </control>
                    </focusedlayout>
                </control>

                <!--name field-->
                <control type="image">
                    <posy>96</posy>
                    <width>12_col</width>
                    <height>96</height>
                    <texture>colors/black.png</texture>
                    <colordiffuse>overlay</colordiffuse>
                </control>
                <control type="edit" id="12">
                    <description>Name Button</description>
                    <posx>12</posx>
                    <posy>3_row</posy>
                    <width>12_col_gutter</width>
                    <hinttext>$LOCALIZE[31209]</hinttext>
                    <textoffsetx>112</textoffsetx>
                    <font>item_title</font>
                    <align>left</align>
                    <onup>10</onup>
                    <ondown>8001</ondown>
                </control>
                <control type="label">
                    <posx>24</posx>
                    <posy>3_row</posy>
                    <width>3_col</width>
                    <height>2_row</height>
                    <font>item_title</font>
                    <label>$LOCALIZE[551]:</label>
                </control>
            </control>

            <!--OK / Cancel-->
            <control type="group">
                <posy>312</posy>
                <control type="panel" id="8001">
                    <posx>4_col</posx>
                    <width>8_col</width>
                    <height>2_row</height>
                    <orientation>horizontal</orientation>
                    <onup>12</onup>
                    <itemlayout width="4_col" height="2_row">
                        <control type="image">
                            <width>1_col_textbox</width>
                            <height>2_row</height>
                            <texture>colors/black.png</texture>
                            <colordiffuse>overlay</colordiffuse>
                        </control>
                        <control type="image">
                            <posx>1_col</posx>
                            <width>3_col_textbox</width>
                            <height>2_row</height>
                            <texture>colors/black.png</texture>
                            <colordiffuse>overlay</colordiffuse>
                        </control>
                        <control type="label">
                            <width>1_col</width>
                            <height>2_row</height>
                            <align>center</align>
                            <font>symbol_large</font>
                            <label>$INFO[ListItem.label2]</label>
                        </control>
                        <control type="label">
                            <posx>1_col_indent</posx>
                            <posy>-1</posy>
                            <width>3_col_gutter</width>
                            <height>2_row</height>
                            <font>button_title</font>
                            <label>$INFO[ListItem.label]</label>
                        </control>
                    </itemlayout>
                    <focusedlayout width="4_col" height="2_row">
                        <control type="image">
                            <width>1_col</width>
                            <height>2_row</height>
                            <texture>colors/white.png</texture>
                            <colordiffuse>highlight</colordiffuse>
                            <include>spin_focus_icon</include>
                        </control>
                        <control type="image">
                            <posx>1_col</posx>
                            <width>3_col</width>
                            <height>2_row</height>
                            <texture>colors/white.png</texture>
                        </control>
                        <control type="label">
                            <width>1_col</width>
                            <height>2_row</height>
                            <align>center</align>
                            <font>symbol_large</font>
                            <label>$INFO[ListItem.label2]</label>
                        </control>
                        <control type="label">
                            <posx>1_col_indent</posx>
                            <posy>-1</posy>
                            <width>3_col_gutter</width>
                            <height>2_row</height>
                            <font>button_title</font>
                            <textcolor>black</textcolor>
                            <label>$INFO[ListItem.label]</label>
                        </control>
                    </focusedlayout>
                    <content>
                        <item>
                            <description>Ok Button</description>
                            <label>186</label>
                            <label2></label2>
                            <onclick>SendClick(129,18)</onclick>
                        </item>
                        <item>
                            <description>Cancel Button</description>
                            <label>222</label>
                            <label2></label2>
                            <onclick>SendClick(129,19)</onclick>
                        </item>
                    </content>
                </control>
            </control>
        </control>
        <!--buttons-->
        <control type="group">
            <visible>false</visible>
            <control type="button" id="11">
                <description>Browse Button</description>
            </control>
            <control type="button" id="13">
                <description>Add Path Button</description>
            </control>
            <control type="button" id="14">
                <description>Remove Path Button</description>
            </control>
            <control type="button" id="18">
                <description>Ok Button</description>
            </control>
            <control type="button" id="19">
                <description>Cancel Button</description>
            </control>
        </control>
        <include content="debug_overlay"><param name="label" value="DialogMediaSource.xml"/></include>
    </controls>
</window>
